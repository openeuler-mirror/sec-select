@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef _RATS_TLS_CCA_SAMPLE_H
+#define _RATS_TLS_CCA_SAMPLE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <rats-tls/api.h>
+
+#define CCA_SAMPLE_REQUEST_BOOT_LOG "REQUEST_BOOT_LOG"
+#define CCA_SAMPLE_REQUEST_CCEL_TABLE "REQUEST_CCEL_TABLE"
+#define CCA_SAMPLE_REQUEST_EVENT_LOG "REQUEST_EVENT_LOG"
+#define CCA_SAMPLE_REQUEST_IMA_LOG "REQUEST_IMA_LOG"
+#define CCA_SAMPLE_ATTESTATION_PASS "ATTESTATION_PASS"
+#define CCA_SAMPLE_MAX_LOG_SIZE (1024U * 1024U * 1024U)
+#define CCA_SAMPLE_MAX_SW_COMPONENTS 128U
+#define CCA_SAMPLE_MAX_TEXT_FIELD 128U
+#define CCA_SAMPLE_MAX_COMPONENT_DIGEST 64U
+
+typedef struct {
+	const char *realm_profile;
+	const char *platform_profile;
+	uint8_t rim[64];
+	size_t rim_size;
+	uint8_t implementation_id[32];
+	size_t implementation_id_size;
+	uint8_t instance_id[33];
+	size_t instance_id_size;
+} cca_sample_policy_t;
+
+typedef struct {
+	uint8_t rem[RATS_TLS_CCA_REM_COUNT][64];
+	size_t rem_size[RATS_TLS_CCA_REM_COUNT];
+	bool valid;
+} cca_sample_realm_measurements_t;
+
+typedef struct {
+	char component_type[CCA_SAMPLE_MAX_TEXT_FIELD];
+	char version[CCA_SAMPLE_MAX_TEXT_FIELD];
+	char hash_algorithm[CCA_SAMPLE_MAX_TEXT_FIELD];
+	uint8_t measurement[CCA_SAMPLE_MAX_COMPONENT_DIGEST];
+	size_t measurement_size;
+	uint8_t signer_id[CCA_SAMPLE_MAX_COMPONENT_DIGEST];
+	size_t signer_id_size;
+} cca_sample_sw_component_t;
+
+typedef struct {
+	cca_sample_sw_component_t components[CCA_SAMPLE_MAX_SW_COMPONENTS];
+	size_t component_count;
+	bool valid;
+} cca_sample_platform_measurements_t;
+
+extern cca_sample_policy_t cca_sample_policy;
+extern cca_sample_realm_measurements_t cca_sample_realm_measurements;
+extern cca_sample_platform_measurements_t cca_sample_platform_measurements;
+
+int cca_sample_parse_hex(const char *text, uint8_t *output, size_t capacity, size_t *output_size);
+int cca_sample_verify_callback(void *args);
+int cca_sample_parse_log_level(const char *text, rats_tls_log_level_t *level);
+void cca_sample_print_policy_options(void);
+int cca_sample_send_frame(rats_tls_handle handle, const void *data, size_t size);
+int cca_sample_receive_frame(rats_tls_handle handle, void *data, size_t capacity, size_t *size);
+int cca_sample_receive_alloc_frame(rats_tls_handle handle, void **data, size_t maximum,
+				   size_t *size);
+
+#endif
