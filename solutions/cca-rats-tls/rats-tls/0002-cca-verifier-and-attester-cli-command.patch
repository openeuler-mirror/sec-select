diff --git a/samples/cca-common/cca_sample.c b/samples/cca-common/cca_sample.c
new file mode 100644
index 0000000..db668da
--- /dev/null
+++ b/samples/cca-common/cca_sample.c
@@ -0,0 +1,312 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <ctype.h>
+#include <arpa/inet.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <rats-tls/log.h>
+#include "cca_sample.h"
+
+cca_sample_policy_t cca_sample_policy;
+cca_sample_realm_measurements_t cca_sample_realm_measurements;
+cca_sample_platform_measurements_t cca_sample_platform_measurements;
+
+static int hex_value(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+int cca_sample_parse_hex(const char *text, uint8_t *output, size_t capacity, size_t *output_size)
+{
+	if (!text || !output || !output_size)
+		return -1;
+
+	size_t length = strlen(text);
+	if (length == 0 || (length & 1) || length / 2 > capacity)
+		return -1;
+
+	for (size_t i = 0; i < length / 2; ++i) {
+		int high = hex_value(text[i * 2]);
+		int low = hex_value(text[i * 2 + 1]);
+		if (high < 0 || low < 0)
+			return -1;
+		output[i] = (uint8_t)((high << 4) | low);
+	}
+	*output_size = length / 2;
+	return 0;
+}
+
+static void print_hex(const char *name, const rtls_cca_buffer_t *value)
+{
+	printf("%s: ", name);
+	if (!value->data) {
+		printf("<not present>\n");
+		return;
+	}
+	for (size_t i = 0; i < value->size; ++i)
+		printf("%02x", value->data[i]);
+	printf("\n");
+}
+
+static void print_text(const char *name, const rtls_cca_buffer_t *value)
+{
+	if (!value->data) {
+		printf("%s: <not present>\n", name);
+		return;
+	}
+	printf("%s: %.*s\n", name, (int)value->size, (const char *)value->data);
+}
+
+static bool buffer_matches_text(const rtls_cca_buffer_t *actual, const char *expected)
+{
+	size_t expected_size = strlen(expected);
+	return actual->size == expected_size &&
+	       !memcmp(actual->data, expected, expected_size);
+}
+
+static bool buffer_matches_bytes(const rtls_cca_buffer_t *actual, const uint8_t *expected,
+				 size_t expected_size)
+{
+	return actual->size == expected_size && !memcmp(actual->data, expected, expected_size);
+}
+
+static int copy_text_field(char *destination, size_t capacity, const rtls_cca_buffer_t *source)
+{
+	if (!source->data || source->size == 0) {
+		destination[0] = '\0';
+		return 0;
+	}
+	if (source->size >= capacity)
+		return -1;
+	memcpy(destination, source->data, source->size);
+	destination[source->size] = '\0';
+	return 0;
+}
+
+static int copy_binary_field(uint8_t *destination, size_t capacity, size_t *destination_size,
+			     const rtls_cca_buffer_t *source)
+{
+	*destination_size = 0;
+	if (!source->data || source->size == 0)
+		return 0;
+	if (source->size > capacity)
+		return -1;
+	memcpy(destination, source->data, source->size);
+	*destination_size = source->size;
+	return 0;
+}
+
+int cca_sample_verify_callback(void *args)
+{
+	rtls_evidence_t *evidence = args;
+	if (!evidence || evidence->type != CCA_EVIDENCE) {
+		RTLS_ERR("verification callback received non-CCA evidence\n");
+		return 0;
+	}
+
+	const rtls_cca_realm_claims_t *realm = &evidence->cca.realm;
+	const rtls_cca_platform_claims_t *platform = &evidence->cca.platform;
+
+	print_text("CCA realm profile", &realm->profile);
+	print_hex("CCA realm initial measurement", &realm->initial_measurement);
+	for (size_t i = 0; i < RATS_TLS_CCA_REM_COUNT; ++i) {
+		char name[64];
+		snprintf(name, sizeof(name), "CCA realm extensible measurement[%zu]", i);
+		print_hex(name, &realm->extensible_measurements[i]);
+		if (realm->extensible_measurements[i].size >
+		    sizeof(cca_sample_realm_measurements.rem[i])) {
+			RTLS_ERR("CCA REM%zu is too large\n", i);
+			return 0;
+		}
+		cca_sample_realm_measurements.rem_size[i] =
+			realm->extensible_measurements[i].size;
+		if (realm->extensible_measurements[i].size)
+			memcpy(cca_sample_realm_measurements.rem[i],
+			       realm->extensible_measurements[i].data,
+			       realm->extensible_measurements[i].size);
+	}
+	print_text("CCA realm hash algorithm", &realm->hash_algorithm);
+	print_text("CCA platform profile", &platform->profile);
+	print_hex("CCA platform implementation ID", &platform->implementation_id);
+	print_hex("CCA platform instance ID", &platform->instance_id);
+	printf("CCA platform lifecycle: 0x%04x\n", platform->lifecycle);
+	print_text("CCA platform hash algorithm", &platform->hash_algorithm);
+
+	memset(&cca_sample_platform_measurements, 0, sizeof(cca_sample_platform_measurements));
+	if (platform->software_component_count > CCA_SAMPLE_MAX_SW_COMPONENTS) {
+		RTLS_ERR("CCA software component count %zu exceeds %u\n",
+			 platform->software_component_count, CCA_SAMPLE_MAX_SW_COMPONENTS);
+		return 0;
+	}
+	cca_sample_platform_measurements.component_count = platform->software_component_count;
+	for (size_t i = 0; i < platform->software_component_count; ++i) {
+		const rtls_cca_sw_component_t *component = &platform->software_components[i];
+		printf("CCA software component[%zu]\n", i);
+		print_text("  type", &component->component_type);
+		print_hex("  measurement", &component->measurement);
+		print_text("  version", &component->version);
+		print_hex("  signer ID", &component->signer_id);
+		print_text("  hash algorithm", &component->hash_algorithm);
+		cca_sample_sw_component_t *snapshot =
+			&cca_sample_platform_measurements.components[i];
+		if (copy_text_field(snapshot->component_type, sizeof(snapshot->component_type),
+				    &component->component_type) ||
+		    copy_binary_field(snapshot->measurement, sizeof(snapshot->measurement),
+				      &snapshot->measurement_size, &component->measurement) ||
+		    copy_text_field(snapshot->version, sizeof(snapshot->version),
+				    &component->version) ||
+		    copy_binary_field(snapshot->signer_id, sizeof(snapshot->signer_id),
+				      &snapshot->signer_id_size, &component->signer_id) ||
+		    copy_text_field(snapshot->hash_algorithm, sizeof(snapshot->hash_algorithm),
+				    &component->hash_algorithm)) {
+			RTLS_ERR("failed to copy CCA software component[%zu]\n", i);
+			return 0;
+		}
+	}
+
+	if (cca_sample_policy.realm_profile &&
+	    !buffer_matches_text(&realm->profile, cca_sample_policy.realm_profile)) {
+		RTLS_ERR("CCA realm profile baseline mismatch\n");
+		return 0;
+	}
+	if (cca_sample_policy.platform_profile &&
+	    !buffer_matches_text(&platform->profile, cca_sample_policy.platform_profile)) {
+		RTLS_ERR("CCA platform profile baseline mismatch\n");
+		return 0;
+	}
+	if (cca_sample_policy.rim_size &&
+	    !buffer_matches_bytes(&realm->initial_measurement, cca_sample_policy.rim,
+				  cca_sample_policy.rim_size)) {
+		RTLS_ERR("CCA RIM baseline mismatch\n");
+		return 0;
+	}
+	if (cca_sample_policy.implementation_id_size &&
+	    !buffer_matches_bytes(&platform->implementation_id,
+				  cca_sample_policy.implementation_id,
+				  cca_sample_policy.implementation_id_size)) {
+		RTLS_ERR("CCA implementation ID baseline mismatch\n");
+		return 0;
+	}
+	if (cca_sample_policy.instance_id_size &&
+	    !buffer_matches_bytes(&platform->instance_id, cca_sample_policy.instance_id,
+				  cca_sample_policy.instance_id_size)) {
+		RTLS_ERR("CCA instance ID baseline mismatch\n");
+		return 0;
+	}
+
+	cca_sample_realm_measurements.valid = true;
+	cca_sample_platform_measurements.valid = true;
+	RTLS_INFO("CCA sample baseline verification passed\n");
+	return 1;
+}
+
+int cca_sample_parse_log_level(const char *text, rats_tls_log_level_t *level)
+{
+	if (!strcasecmp(text, "debug"))
+		*level = RATS_TLS_LOG_LEVEL_DEBUG;
+	else if (!strcasecmp(text, "info"))
+		*level = RATS_TLS_LOG_LEVEL_INFO;
+	else if (!strcasecmp(text, "warn"))
+		*level = RATS_TLS_LOG_LEVEL_WARN;
+	else if (!strcasecmp(text, "error"))
+		*level = RATS_TLS_LOG_LEVEL_ERROR;
+	else if (!strcasecmp(text, "fatal"))
+		*level = RATS_TLS_LOG_LEVEL_FATAL;
+	else if (!strcasecmp(text, "off"))
+		*level = RATS_TLS_LOG_LEVEL_NONE;
+	else
+		return -1;
+	return 0;
+}
+
+void cca_sample_print_policy_options(void)
+{
+	puts("        --realm-profile value      expected Realm profile\n"
+	     "        --platform-profile value   expected Platform profile\n"
+	     "        --rim hex                  expected Realm initial measurement\n"
+	     "        --implementation-id hex    expected 32-byte implementation ID\n"
+	     "        --instance-id hex          expected 33-byte instance ID");
+}
+
+static int transmit_all(rats_tls_handle handle, const uint8_t *data, size_t size)
+{
+	while (size) {
+		size_t chunk = size;
+		if (rats_tls_transmit(handle, (void *)data, &chunk) != RATS_TLS_ERR_NONE ||
+		    chunk == 0 || chunk > size)
+			return -1;
+		data += chunk;
+		size -= chunk;
+	}
+	return 0;
+}
+
+static int receive_all(rats_tls_handle handle, uint8_t *data, size_t size)
+{
+	while (size) {
+		size_t chunk = size;
+		if (rats_tls_receive(handle, data, &chunk) != RATS_TLS_ERR_NONE || chunk == 0 ||
+		    chunk > size)
+			return -1;
+		data += chunk;
+		size -= chunk;
+	}
+	return 0;
+}
+
+int cca_sample_send_frame(rats_tls_handle handle, const void *data, size_t size)
+{
+	if (!handle || (!data && size) || size > UINT32_MAX)
+		return -1;
+	uint32_t network_size = htonl((uint32_t)size);
+	return transmit_all(handle, (const uint8_t *)&network_size, sizeof(network_size)) ||
+		       transmit_all(handle, data, size) ?
+		       -1 :
+		       0;
+}
+
+int cca_sample_receive_frame(rats_tls_handle handle, void *data, size_t capacity, size_t *size)
+{
+	if (!handle || !data || !size)
+		return -1;
+	uint32_t network_size = 0;
+	if (receive_all(handle, (uint8_t *)&network_size, sizeof(network_size)))
+		return -1;
+	uint32_t payload_size = ntohl(network_size);
+	if (payload_size == 0 || payload_size > capacity)
+		return -1;
+	if (receive_all(handle, data, payload_size))
+		return -1;
+	*size = payload_size;
+	return 0;
+}
+
+int cca_sample_receive_alloc_frame(rats_tls_handle handle, void **data, size_t maximum,
+				   size_t *size)
+{
+	if (!handle || !data || !size || maximum == 0 || maximum > UINT32_MAX)
+		return -1;
+	uint32_t network_size = 0;
+	if (receive_all(handle, (uint8_t *)&network_size, sizeof(network_size)))
+		return -1;
+	uint32_t payload_size = ntohl(network_size);
+	if (payload_size == 0 || payload_size > maximum)
+		return -1;
+	void *buffer = malloc(payload_size);
+	if (!buffer)
+		return -1;
+	if (receive_all(handle, buffer, payload_size)) {
+		free(buffer);
+		return -1;
+	}
+	*data = buffer;
+	*size = payload_size;
+	return 0;
+}
