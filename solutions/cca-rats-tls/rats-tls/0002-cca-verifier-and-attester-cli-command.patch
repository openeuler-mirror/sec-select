diff --git a/samples/cca-client/client.c b/samples/cca-client/client.c
new file mode 100644
index 0000000..6bab0e7
--- /dev/null
+++ b/samples/cca-client/client.c
@@ -0,0 +1,249 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <arpa/inet.h>
+#include <errno.h>
+#include <getopt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <rats-tls/api.h>
+#include <rats-tls/log.h>
+#include "cca_log.h"
+#include "cca_policy.h"
+#include "cca_sample.h"
+
+#define DEFAULT_IP "127.0.0.1"
+#define DEFAULT_PORT 1234
+#define DEFAULT_MESSAGE "Hello from CCA RA-TLS client"
+
+rats_tls_log_level_t global_log_level = RATS_TLS_LOG_LEVEL_DEFAULT;
+
+static void usage(const char *program)
+{
+	printf("Usage: %s [options]\n"
+	       "        --ip/-i value             server IPv4 address (default 127.0.0.1)\n"
+	       "        --port/-p value           server TCP port (default 1234)\n"
+	       "        --message/-M value        echo message\n"
+	       "        --ima-log/-I              parse IMA log and optionally verify baselines\n"
+	       "        --digest/-d value         additionally verify <algorithm> <digest> <path> baselines\n"
+	       "        --bootlog/-g              dump and replay the CCA event log\n"
+	       "        --platform/-P value       verify platform component JSON baselines\n"
+	       "        --firmware/-f value       verify CCA firmware JSON baseline\n"
+	       "        --dump-bootlog            also save boot_log.bin\n"
+	       "        --mutual/-m               enable mutual CCA attestation\n"
+	       "        --log-level/-l value      debug|info|warn|error|fatal|off\n",
+	       program);
+	cca_sample_print_policy_options();
+	puts("        --help/-h                 show this help");
+}
+
+static int configure_policy(int option, const char *value)
+{
+	switch (option) {
+	case 1000:
+		cca_sample_policy.realm_profile = value;
+		return 0;
+	case 1001:
+		cca_sample_policy.platform_profile = value;
+		return 0;
+	case 1002:
+		return cca_sample_parse_hex(value, cca_sample_policy.rim,
+					    sizeof(cca_sample_policy.rim),
+					    &cca_sample_policy.rim_size);
+	case 1003:
+		if (cca_sample_parse_hex(value, cca_sample_policy.implementation_id,
+					 sizeof(cca_sample_policy.implementation_id),
+					 &cca_sample_policy.implementation_id_size))
+			return -1;
+		return cca_sample_policy.implementation_id_size == 32 ? 0 : -1;
+	case 1004:
+		if (cca_sample_parse_hex(value, cca_sample_policy.instance_id,
+					 sizeof(cca_sample_policy.instance_id),
+					 &cca_sample_policy.instance_id_size))
+			return -1;
+		return cca_sample_policy.instance_id_size == 33 ? 0 : -1;
+	default:
+		return -1;
+	}
+}
+
+int main(int argc, char **argv)
+{
+	const char *ip = DEFAULT_IP;
+	const char *message = DEFAULT_MESSAGE;
+	const char *digest_file = NULL;
+	const char *platform_file = NULL;
+	const char *firmware_file = NULL;
+	int port = DEFAULT_PORT;
+	bool mutual = false;
+	bool verify_ima_log = false;
+	bool verify_boot_log = false;
+	bool dump_boot_log = false;
+	bool eventlog_dump = false;
+	rats_tls_log_level_t log_level = RATS_TLS_LOG_LEVEL_INFO;
+	static const struct option options[] = {
+		{ "ip", required_argument, NULL, 'i' },
+		{ "port", required_argument, NULL, 'p' },
+		{ "message", required_argument, NULL, 'M' },
+		{ "ima-log", no_argument, NULL, 'I' },
+		{ "digest", required_argument, NULL, 'd' },
+		{ "bootlog", no_argument, NULL, 'g' },
+		{ "platform", required_argument, NULL, 'P' },
+		{ "firmware", required_argument, NULL, 'f' },
+		{ "dump-bootlog", no_argument, NULL, 1005 },
+		{ "mutual", no_argument, NULL, 'm' },
+		{ "log-level", required_argument, NULL, 'l' },
+		{ "realm-profile", required_argument, NULL, 1000 },
+		{ "platform-profile", required_argument, NULL, 1001 },
+		{ "rim", required_argument, NULL, 1002 },
+		{ "implementation-id", required_argument, NULL, 1003 },
+		{ "instance-id", required_argument, NULL, 1004 },
+		{ "help", no_argument, NULL, 'h' },
+		{ 0, 0, 0, 0 },
+	};
+
+	int option;
+	while ((option = getopt_long(argc, argv, "i:p:M:Id:gP:f:ml:h", options, NULL)) != -1) {
+		switch (option) {
+		case 'i':
+			ip = optarg;
+			break;
+		case 'p':
+			port = atoi(optarg);
+			break;
+		case 'M':
+			message = optarg;
+			break;
+		case 'I':
+			verify_ima_log = true;
+			break;
+		case 'd':
+			digest_file = optarg;
+			verify_ima_log = true;
+			break;
+		case 'g':
+			verify_boot_log = true;
+			dump_boot_log = true;
+			eventlog_dump = true;
+			break;
+		case 'P':
+			platform_file = optarg;
+			break;
+		case 'f':
+			firmware_file = optarg;
+			verify_boot_log = true;
+			break;
+		case 'm':
+			mutual = true;
+			break;
+		case 'l':
+			if (cca_sample_parse_log_level(optarg, &log_level))
+				goto invalid;
+			break;
+		case 'h':
+			usage(argv[0]);
+			return 0;
+		default:
+			if (option == 1005) {
+				verify_boot_log = true;
+				dump_boot_log = true;
+				break;
+			}
+			if (configure_policy(option, optarg))
+				goto invalid;
+			break;
+		}
+	}
+	if (port <= 0 || port > 65535)
+		goto invalid;
+	global_log_level = log_level;
+
+	int socket_fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (socket_fd < 0) {
+		RTLS_ERR("socket failed: %s\n", strerror(errno));
+		return 1;
+	}
+	struct sockaddr_in address = {
+		.sin_family = AF_INET,
+		.sin_port = htons((uint16_t)port),
+	};
+	if (inet_pton(AF_INET, ip, &address.sin_addr) != 1 ||
+	    connect(socket_fd, (struct sockaddr *)&address, sizeof(address))) {
+		RTLS_ERR("connect failed: %s\n", strerror(errno));
+		close(socket_fd);
+		return 1;
+	}
+
+	rats_tls_conf_t config = {
+		.log_level = log_level,
+		.cert_algo = RATS_TLS_CERT_ALGO_DEFAULT,
+	};
+	snprintf(config.verifier_type, sizeof(config.verifier_type), "cca");
+	snprintf(config.tls_type, sizeof(config.tls_type), "openssl");
+	snprintf(config.crypto_type, sizeof(config.crypto_type), "openssl");
+	if (mutual) {
+		config.flags |= RATS_TLS_CONF_FLAGS_MUTUAL;
+		snprintf(config.attester_type, sizeof(config.attester_type), "cca");
+	}
+
+	rats_tls_handle handle = NULL;
+	rats_tls_err_t result = rats_tls_init(&config, &handle);
+	if (result != RATS_TLS_ERR_NONE ||
+	    rats_tls_set_verification_callback(&handle, cca_sample_verify_callback) !=
+		    RATS_TLS_ERR_NONE ||
+	    rats_tls_negotiate(handle, socket_fd) != RATS_TLS_ERR_NONE)
+		goto tls_error;
+
+	if (verify_ima_log && cca_verify_ima_log(handle, digest_file))
+		goto tls_error;
+	if (platform_file && cca_verify_platform_file(platform_file))
+		goto tls_error;
+	if (verify_boot_log &&
+	    cca_verify_boot_log(handle, dump_boot_log, eventlog_dump, firmware_file))
+		goto tls_error;
+
+	size_t message_size = strlen(message);
+	if (message_size == 0 || message_size > 4096 ||
+	    cca_sample_send_frame(handle, message, message_size))
+		goto tls_error;
+
+	char response[4096];
+	size_t response_size = 0;
+	if (cca_sample_receive_frame(handle, response, sizeof(response) - 1, &response_size))
+		goto tls_error;
+	response[response_size] = '\0';
+	printf("CCA server: %s\n", response);
+	if (response_size != strlen(message) || memcmp(response, message, response_size)) {
+		RTLS_ERR("server returned an unexpected response\n");
+		goto tls_error;
+	}
+
+	if (cca_sample_send_frame(handle, CCA_SAMPLE_ATTESTATION_PASS,
+				  strlen(CCA_SAMPLE_ATTESTATION_PASS)))
+		goto tls_error;
+	char pass_response[64];
+	size_t pass_response_size = 0;
+	if (cca_sample_receive_frame(handle, pass_response, sizeof(pass_response),
+				     &pass_response_size) ||
+	    pass_response_size != strlen(CCA_SAMPLE_ATTESTATION_PASS) ||
+	    memcmp(pass_response, CCA_SAMPLE_ATTESTATION_PASS, pass_response_size)) {
+		RTLS_ERR("server did not acknowledge successful attestation\n");
+		goto tls_error;
+	}
+	RTLS_INFO("CCA log and baseline verification passed\n");
+
+	rats_tls_cleanup(handle);
+	close(socket_fd);
+	return 0;
+
+tls_error:
+	RTLS_ERR("CCA RA-TLS client failed\n");
+	if (handle)
+		rats_tls_cleanup(handle);
+	close(socket_fd);
+	return 1;
+invalid:
+	usage(argv[0]);
+	return 1;
+}
diff --git a/samples/cca-common/cca_log.c b/samples/cca-common/cca_log.c
new file mode 100644
index 0000000..5fd4834
--- /dev/null
+++ b/samples/cca-common/cca_log.c
@@ -0,0 +1,1045 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <ctype.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <openssl/evp.h>
+#include <rats-tls/log.h>
+#include <uthash.h>
+#include "cca_log.h"
+#include "cca_sample.h"
+
+#define SHA1_SIZE	       20U
+#define SHA256_SIZE	       32U
+#define MAX_TEMPLATE_NAME      255U
+#define MAX_TEMPLATE_DATA      (16U * 1024U * 1024U)
+#define MAX_EVENT_DATA	       (16U * 1024U * 1024U)
+#define MAX_IMA_ENTRIES	       100000U
+#define MAX_IMA_BASELINES      100000U
+#define MAX_FIRMWARE_JSON_SIZE (16U * 1024U * 1024U)
+#define HASH_HEX_SIZE	       (SHA256_SIZE * 2U)
+#define MAX_IMA_PATH	       4096U
+#define TPM_ALG_SHA1	       0x0004U
+#define TPM_ALG_SHA256	       0x000bU
+#define TPM_ALG_SHA384	       0x000cU
+#define TPM_ALG_SHA512	       0x000dU
+#define EV_NO_ACTION	       0x00000003U
+#define EV_IPL		       0x0000000dU
+#define EV_EFI_EVENT_BASE      0x80000000U
+#define EV_EFI_BOOT_SERVICES_APPLICATION (EV_EFI_EVENT_BASE + 0x3U)
+
+typedef struct {
+	const uint8_t *data;
+	size_t size;
+	size_t offset;
+} cursor_t;
+
+typedef struct ima_baseline {
+	uint8_t *key;
+	size_t key_size;
+	UT_hash_handle hh;
+} ima_baseline_t;
+
+typedef struct {
+	uint8_t (*efi_images)[SHA256_SIZE];
+	size_t efi_image_count;
+	uint8_t grub_config[SHA256_SIZE];
+	bool has_grub_config;
+	uint8_t kernel[SHA256_SIZE];
+	bool has_kernel;
+	uint8_t initramfs[SHA256_SIZE];
+	bool has_initramfs;
+} firmware_state_t;
+
+typedef struct {
+	char *version;
+	char *kernel;
+	char *initramfs;
+} kernel_reference_t;
+
+typedef struct {
+	char *grub;
+	char *grub_cfg;
+	char *hash_alg;
+	kernel_reference_t *kernels;
+	size_t kernel_count;
+} firmware_reference_t;
+
+typedef struct {
+	uint8_t revision;
+	uint8_t checksum;
+	char oem_id[6];
+	uint8_t cc_type;
+	uint8_t cc_subtype;
+	uint64_t log_length;
+	uint64_t log_address;
+} ccel_table_info_t;
+
+static size_t digest_size(uint16_t algorithm);
+
+static uint64_t get_le64_unaligned(const uint8_t *data)
+{
+	uint64_t value = 0;
+	for (size_t i = 0; i < 8; ++i)
+		value |= (uint64_t)data[i] << (i * 8);
+	return value;
+}
+
+static void print_hex_dump_with_ascii(const uint8_t *data, size_t size, size_t base)
+{
+	char ascii[17] = { 0 };
+	for (size_t i = 0; i < size; ++i) {
+		if (i % 16 == 0) {
+			if (i > 0)
+				printf("  %s\n", ascii);
+			printf("%08zx  ", base + i);
+			memset(ascii, 0, sizeof(ascii));
+		}
+		printf("%02x ", data[i]);
+		ascii[i % 16] = isprint((unsigned char)data[i]) ? (char)data[i] : '.';
+	}
+	if (size % 16) {
+		for (size_t i = size % 16; i < 16; ++i)
+			printf("   ");
+	}
+	printf("  %s\n", ascii);
+}
+
+static int parse_ccel_table(const uint8_t *data, size_t size, ccel_table_info_t *info)
+{
+	if (!data || !info || size < 56 || memcmp(data, "CCEL", 4)) {
+		RTLS_ERR("invalid CCEL ACPI table\n");
+		return -1;
+	}
+	memset(info, 0, sizeof(*info));
+	info->revision = data[8];
+	info->checksum = data[9];
+	memcpy(info->oem_id, data + 10, sizeof(info->oem_id));
+	info->cc_type = data[36];
+	info->cc_subtype = data[37];
+	info->log_length = get_le64_unaligned(data + 40);
+	info->log_address = get_le64_unaligned(data + 48);
+	return 0;
+}
+
+static void print_ccel_table(const uint8_t *data, size_t size, const ccel_table_info_t *info)
+{
+	printf("=> Read CCEL ACPI Table\n");
+	print_hex_dump_with_ascii(data, size, 0);
+	printf("Revision:     %u\n", info->revision);
+	printf("Length:       %zu\n", size);
+	printf("Checksum:     %02x\n", info->checksum);
+	printf("OEM ID:       b'");
+	for (size_t i = 0; i < sizeof(info->oem_id); ++i)
+		printf("%c", isprint((unsigned char)info->oem_id[i]) ? info->oem_id[i] : '.');
+	printf("'\n");
+	printf("CC Type:      %u\n", info->cc_type);
+	printf("CC Sub-type:  %u\n", info->cc_subtype);
+	printf("Log Lenght:   0x%08lx\n", (unsigned long)info->log_length);
+	printf("Log Address:  0x%08lx\n", (unsigned long)info->log_address);
+	printf("\n");
+}
+
+static int get_u16(cursor_t *cursor, uint16_t *value)
+{
+	if (cursor->size - cursor->offset < 2)
+		return -1;
+	const uint8_t *p = cursor->data + cursor->offset;
+	*value = (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+	cursor->offset += 2;
+	return 0;
+}
+
+static int get_u32(cursor_t *cursor, uint32_t *value)
+{
+	if (cursor->size - cursor->offset < 4)
+		return -1;
+	const uint8_t *p = cursor->data + cursor->offset;
+	*value = (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+		 ((uint32_t)p[3] << 24);
+	cursor->offset += 4;
+	return 0;
+}
+
+static int get_bytes(cursor_t *cursor, size_t size, const uint8_t **data)
+{
+	if (size > cursor->size - cursor->offset)
+		return -1;
+	*data = cursor->data + cursor->offset;
+	cursor->offset += size;
+	return 0;
+}
+
+static int sha256_two(const uint8_t first[SHA256_SIZE], const uint8_t second[SHA256_SIZE],
+		      uint8_t output[SHA256_SIZE])
+{
+	EVP_MD_CTX *context = EVP_MD_CTX_new();
+	unsigned int output_size = 0;
+	int result = -1;
+	if (context && EVP_DigestInit_ex(context, EVP_sha256(), NULL) == 1 &&
+	    EVP_DigestUpdate(context, first, SHA256_SIZE) == 1 &&
+	    EVP_DigestUpdate(context, second, SHA256_SIZE) == 1 &&
+	    EVP_DigestFinal_ex(context, output, &output_size) == 1 && output_size == SHA256_SIZE)
+		result = 0;
+	EVP_MD_CTX_free(context);
+	return result;
+}
+
+static int sha256(const void *data, size_t size, uint8_t output[SHA256_SIZE])
+{
+	unsigned int output_size = 0;
+	return EVP_Digest(data, size, output, &output_size, EVP_sha256(), NULL) == 1 &&
+			       output_size == SHA256_SIZE ?
+		       0 :
+		       -1;
+}
+
+static int sha1(const void *data, size_t size, uint8_t output[SHA1_SIZE])
+{
+	unsigned int output_size = 0;
+	return EVP_Digest(data, size, output, &output_size, EVP_sha1(), NULL) == 1 &&
+			       output_size == SHA1_SIZE ?
+		       0 :
+		       -1;
+}
+
+static int receive_log(rats_tls_handle handle, const char *request, size_t maximum, uint8_t **data,
+		       size_t *size)
+{
+	if (cca_sample_send_frame(handle, request, strlen(request)))
+		return -1;
+
+	void *buffer = NULL;
+	if (cca_sample_receive_alloc_frame(handle, &buffer, maximum, size)) {
+		return -1;
+	}
+	*data = buffer;
+	return 0;
+}
+
+static void dump_binary_file(const char *path, const uint8_t *data, size_t size)
+{
+	FILE *file = fopen(path, "wb");
+	if (!file) {
+		RTLS_WARN("failed to open %s for dump: %s\n", path, strerror(errno));
+		return;
+	}
+	if (fwrite(data, 1, size, file) != size)
+		RTLS_WARN("failed to write complete dump file %s\n", path);
+	fclose(file);
+}
+
+static int ima_algorithm(const uint8_t *name, size_t size, uint8_t *algorithm,
+			 size_t *digest_length)
+{
+	if (size == 6 && !strncasecmp((const char *)name, "sha256", size)) {
+		*algorithm = 2;
+		*digest_length = SHA256_SIZE;
+		return 0;
+	}
+	if (size == 4 && !strncasecmp((const char *)name, "sha1", size)) {
+		*algorithm = 1;
+		*digest_length = SHA1_SIZE;
+		return 0;
+	}
+	return -1;
+}
+
+static int build_ima_key(uint8_t algorithm, const uint8_t *digest, size_t digest_length,
+			 const uint8_t *path, size_t path_length, uint8_t *key, size_t capacity,
+			 size_t *key_size)
+{
+	if (!digest || !path || path_length == 0 || path_length > MAX_IMA_PATH ||
+	    1 + digest_length + path_length > capacity)
+		return -1;
+	key[0] = algorithm;
+	memcpy(key + 1, digest, digest_length);
+	memcpy(key + 1 + digest_length, path, path_length);
+	*key_size = 1 + digest_length + path_length;
+	return 0;
+}
+
+static int parse_ima_identity(const uint8_t *template_data, size_t template_size,
+			      uint8_t *algorithm, const uint8_t **digest, size_t *digest_length,
+			      const uint8_t **path, size_t *path_length)
+{
+	cursor_t cursor = { template_data, template_size, 0 };
+	uint32_t field_size;
+	const uint8_t *field;
+	if (get_u32(&cursor, &field_size) || field_size > template_size ||
+	    get_bytes(&cursor, field_size, &field))
+		return -1;
+
+	const uint8_t *separator = memchr(field, ':', field_size);
+	if (!separator)
+		return -1;
+	size_t algorithm_size = (size_t)(separator - field);
+	if (ima_algorithm(field, algorithm_size, algorithm, digest_length))
+		return -1;
+	const uint8_t *digest_start = separator + 1;
+	if (digest_start < field + field_size && *digest_start == '\0')
+		++digest_start;
+	if ((size_t)(field + field_size - digest_start) != *digest_length)
+		return -1;
+	*digest = digest_start;
+
+	if (get_u32(&cursor, &field_size) || field_size == 0 || field_size > MAX_IMA_PATH + 1 ||
+	    get_bytes(&cursor, field_size, path))
+		return -1;
+	*path_length = field_size;
+	while (*path_length && (*path)[*path_length - 1] == '\0')
+		--*path_length;
+	if (*path_length == 0 || *path_length > MAX_IMA_PATH)
+		return -1;
+	return 0;
+}
+
+static void free_ima_baselines(ima_baseline_t **baselines)
+{
+	ima_baseline_t *entry;
+	ima_baseline_t *temporary;
+	HASH_ITER(hh, *baselines, entry, temporary)
+	{
+		HASH_DEL(*baselines, entry);
+		free(entry->key);
+		free(entry);
+	}
+}
+
+static char *read_text_file(const char *path, size_t maximum)
+{
+	FILE *file = fopen(path, "rb");
+	if (!file) {
+		RTLS_ERR("failed to open firmware baseline %s: %s\n", path, strerror(errno));
+		return NULL;
+	}
+	if (fseek(file, 0, SEEK_END)) {
+		fclose(file);
+		return NULL;
+	}
+	long length = ftell(file);
+	if (length <= 0 || (size_t)length > maximum) {
+		RTLS_ERR("firmware baseline %s size %ld is invalid\n", path, length);
+		fclose(file);
+		return NULL;
+	}
+	rewind(file);
+	char *content = malloc((size_t)length + 1);
+	if (!content) {
+		fclose(file);
+		return NULL;
+	}
+	size_t got = fread(content, 1, (size_t)length, file);
+	fclose(file);
+	if (got != (size_t)length) {
+		RTLS_ERR("failed to read firmware baseline %s\n", path);
+		free(content);
+		return NULL;
+	}
+	content[got] = '\0';
+	return content;
+}
+
+static char *extract_json_string(const char *json, const char *key)
+{
+	char pattern[128];
+	if (snprintf(pattern, sizeof(pattern), "\"%s\"", key) >= (int)sizeof(pattern))
+		return NULL;
+	const char *pos = strstr(json, pattern);
+	if (!pos)
+		return NULL;
+	pos += strlen(pattern);
+	while (*pos && isspace((unsigned char)*pos))
+		++pos;
+	if (*pos != ':')
+		return NULL;
+	pos++;
+	while (*pos && isspace((unsigned char)*pos))
+		++pos;
+	if (*pos != '"')
+		return NULL;
+	pos++;
+	const char *end = pos;
+	while (*end && *end != '"') {
+		if (*end == '\\' && end[1])
+			end++;
+		end++;
+	}
+	if (*end != '"')
+		return NULL;
+	size_t length = (size_t)(end - pos);
+	char *value = malloc(length + 1);
+	if (!value)
+		return NULL;
+	memcpy(value, pos, length);
+	value[length] = '\0';
+	return value;
+}
+
+static void free_firmware_reference(firmware_reference_t *reference)
+{
+	if (!reference)
+		return;
+	free(reference->grub);
+	free(reference->grub_cfg);
+	free(reference->hash_alg);
+	for (size_t i = 0; i < reference->kernel_count; ++i) {
+		free(reference->kernels[i].version);
+		free(reference->kernels[i].kernel);
+		free(reference->kernels[i].initramfs);
+	}
+	free(reference->kernels);
+	memset(reference, 0, sizeof(*reference));
+}
+
+static int load_firmware_reference(const char *path, firmware_reference_t *reference)
+{
+	char *json = read_text_file(path, MAX_FIRMWARE_JSON_SIZE);
+	if (!json)
+		return -1;
+	memset(reference, 0, sizeof(*reference));
+	reference->grub = extract_json_string(json, "grub");
+	reference->grub_cfg = extract_json_string(json, "grub.cfg");
+	reference->hash_alg = extract_json_string(json, "hash_alg");
+
+	char *kernels = strstr(json, "\"kernels\"");
+	if (kernels)
+		kernels = strchr(kernels, '[');
+	char *kernels_end = kernels ? strchr(kernels, ']') : NULL;
+	if (kernels && kernels_end) {
+		for (char *pos = kernels; pos < kernels_end; ++pos) {
+			if (*pos == '{')
+				++reference->kernel_count;
+		}
+		if (reference->kernel_count) {
+			reference->kernels =
+				calloc(reference->kernel_count, sizeof(*reference->kernels));
+			if (!reference->kernels)
+				goto error;
+			size_t index = 0;
+			char *pos = kernels;
+			while (index < reference->kernel_count && pos < kernels_end) {
+				char *object = strchr(pos, '{');
+				if (!object || object >= kernels_end)
+					break;
+				char *object_end = strchr(object, '}');
+				if (!object_end || object_end >= kernels_end)
+					break;
+				char saved = object_end[1];
+				object_end[1] = '\0';
+				reference->kernels[index].version =
+					extract_json_string(object, "version");
+				reference->kernels[index].kernel =
+					extract_json_string(object, "kernel");
+				reference->kernels[index].initramfs =
+					extract_json_string(object, "initramfs");
+				object_end[1] = saved;
+				++index;
+				pos = object_end + 1;
+			}
+		}
+	}
+
+	if (!reference->grub || !reference->grub_cfg || !reference->hash_alg ||
+	    reference->kernel_count == 0) {
+		RTLS_ERR("firmware JSON baseline must contain hash_alg, grub, grub.cfg and kernels\n");
+		goto error;
+	}
+	if (strcmp(reference->hash_alg, "sha-256")) {
+		RTLS_ERR("unsupported firmware baseline hash_alg: %s\n", reference->hash_alg);
+		goto error;
+	}
+	free(json);
+	RTLS_INFO("loaded CCA firmware JSON baseline with %zu kernel entries\n",
+		  reference->kernel_count);
+	return 0;
+error:
+	free(json);
+	free_firmware_reference(reference);
+	return -1;
+}
+
+static bool hex_matches(const char *expected, const uint8_t actual[SHA256_SIZE])
+{
+	uint8_t parsed[SHA256_SIZE];
+	size_t parsed_size = 0;
+	return expected && strlen(expected) == HASH_HEX_SIZE &&
+	       !cca_sample_parse_hex(expected, parsed, sizeof(parsed), &parsed_size) &&
+	       parsed_size == SHA256_SIZE && !memcmp(parsed, actual, SHA256_SIZE);
+}
+
+static int verify_firmware_state(const char *path, const firmware_state_t *state)
+{
+	firmware_reference_t reference;
+	if (load_firmware_reference(path, &reference))
+		return -1;
+
+	int result = -1;
+	bool grub_matched = false;
+	for (size_t i = 0; i < state->efi_image_count; ++i) {
+		if (hex_matches(reference.grub, state->efi_images[i])) {
+			grub_matched = true;
+			break;
+		}
+	}
+	if (!grub_matched) {
+		RTLS_ERR("CCA firmware baseline mismatch: grub\n");
+		goto out;
+	}
+	if (!state->has_grub_config || !hex_matches(reference.grub_cfg, state->grub_config)) {
+		RTLS_ERR("CCA firmware baseline mismatch: grub.cfg\n");
+		goto out;
+	}
+
+	bool kernel_matched = false;
+	for (size_t i = 0; i < reference.kernel_count; ++i) {
+		bool version_matched = true;
+		if (state->has_kernel) {
+			if (!hex_matches(reference.kernels[i].kernel, state->kernel))
+				version_matched = false;
+		}
+		if (version_matched && state->has_initramfs) {
+			if (!hex_matches(reference.kernels[i].initramfs, state->initramfs))
+				version_matched = false;
+		}
+		if (version_matched) {
+			RTLS_INFO("CCA firmware baseline matched kernel version: %s\n",
+				  reference.kernels[i].version ? reference.kernels[i].version :
+								  "<unknown>");
+			kernel_matched = true;
+			break;
+		}
+	}
+	if (!kernel_matched) {
+		RTLS_ERR("CCA firmware baseline mismatch: kernel/initramfs\n");
+		goto out;
+	}
+	RTLS_INFO("CCA firmware JSON baseline verification passed\n");
+	result = 0;
+out:
+	free_firmware_reference(&reference);
+	return result;
+}
+
+static bool bytes_contain_text(const uint8_t *data, size_t size, const char *text)
+{
+	size_t text_size = strlen(text);
+	if (text_size == 0)
+		return true;
+	if (text_size > size)
+		return false;
+	for (size_t i = 0; i <= size - text_size; ++i) {
+		if (!memcmp(data + i, text, text_size))
+			return true;
+	}
+	return false;
+}
+
+static int capture_efi_image(firmware_state_t *state, const uint8_t digest[SHA256_SIZE])
+{
+	uint8_t(*next)[SHA256_SIZE] =
+		realloc(state->efi_images, (state->efi_image_count + 1) * SHA256_SIZE);
+	if (!next)
+		return -1;
+	state->efi_images = next;
+	memcpy(state->efi_images[state->efi_image_count], digest, SHA256_SIZE);
+	++state->efi_image_count;
+	return 0;
+}
+
+static int capture_firmware_state(firmware_state_t *state, uint32_t event_type,
+				  const uint8_t digest[SHA256_SIZE], const uint8_t *event,
+				  size_t event_size)
+{
+	if (event_type == EV_EFI_BOOT_SERVICES_APPLICATION)
+		return capture_efi_image(state, digest);
+	if (event_type != EV_IPL)
+		return 0;
+	if (!state->has_grub_config && event &&
+	    bytes_contain_text(event, event_size, "grub.cfg")) {
+		memcpy(state->grub_config, digest, SHA256_SIZE);
+		state->has_grub_config = true;
+		return 0;
+	}
+	if (!state->has_kernel && event &&
+	    bytes_contain_text(event, event_size, "/vmlinuz-") &&
+	    !bytes_contain_text(event, event_size, "grub_cmd:")) {
+		memcpy(state->kernel, digest, SHA256_SIZE);
+		state->has_kernel = true;
+		return 0;
+	}
+	if (!state->has_initramfs && event &&
+	    bytes_contain_text(event, event_size, "/initramfs-") &&
+	    !bytes_contain_text(event, event_size, "grub_cmd:")) {
+		memcpy(state->initramfs, digest, SHA256_SIZE);
+		state->has_initramfs = true;
+		return 0;
+	}
+	return 0;
+}
+
+static int load_ima_baselines(const char *path, ima_baseline_t **baselines, size_t *baseline_count)
+{
+	FILE *file = fopen(path, "r");
+	if (!file) {
+		RTLS_ERR("failed to open IMA digest baseline %s: %s\n", path, strerror(errno));
+		return -1;
+	}
+
+	char line[MAX_IMA_PATH + 256];
+	size_t line_number = 0;
+	int result = -1;
+	while (fgets(line, sizeof(line), file)) {
+		++line_number;
+		if (!strchr(line, '\n') && !feof(file)) {
+			RTLS_ERR("IMA baseline line %zu is too long\n", line_number);
+			goto out;
+		}
+		char *current = line;
+		while (isspace((unsigned char)*current))
+			++current;
+		if (*current == '\0' || *current == '#')
+			continue;
+		if (++*baseline_count > MAX_IMA_BASELINES) {
+			RTLS_ERR("IMA baseline exceeds %u entries\n", MAX_IMA_BASELINES);
+			goto out;
+		}
+
+		char *algorithm_text = current;
+		while (*current && !isspace((unsigned char)*current))
+			++current;
+		if (!*current)
+			goto malformed;
+		*current++ = '\0';
+		while (isspace((unsigned char)*current))
+			++current;
+		char *digest_text = current;
+		while (*current && !isspace((unsigned char)*current))
+			++current;
+		if (!*current)
+			goto malformed;
+		*current++ = '\0';
+		while (isspace((unsigned char)*current))
+			++current;
+		char *file_path = current;
+		char *end = file_path + strlen(file_path);
+		while (end > file_path && isspace((unsigned char)end[-1]))
+			--end;
+		*end = '\0';
+
+		uint8_t algorithm;
+		size_t digest_length;
+		if (ima_algorithm((const uint8_t *)algorithm_text, strlen(algorithm_text),
+				  &algorithm, &digest_length) ||
+		    strlen(digest_text) != digest_length * 2 || *file_path == '\0' ||
+		    strlen(file_path) > MAX_IMA_PATH)
+			goto malformed;
+		uint8_t digest[64];
+		size_t parsed_size = 0;
+		if (cca_sample_parse_hex(digest_text, digest, sizeof(digest), &parsed_size) ||
+		    parsed_size != digest_length)
+			goto malformed;
+
+		size_t key_size = 1 + digest_length + strlen(file_path);
+		ima_baseline_t *entry = calloc(1, sizeof(*entry));
+		if (!entry)
+			goto out;
+		entry->key = malloc(key_size);
+		if (!entry->key ||
+		    build_ima_key(algorithm, digest, digest_length, (const uint8_t *)file_path,
+				  strlen(file_path), entry->key, key_size, &entry->key_size)) {
+			free(entry->key);
+			free(entry);
+			goto out;
+		}
+		ima_baseline_t *existing;
+		HASH_FIND(hh, *baselines, entry->key, entry->key_size, existing);
+		if (existing) {
+			free(entry->key);
+			free(entry);
+			continue;
+		}
+		HASH_ADD_KEYPTR(hh, *baselines, entry->key, entry->key_size, entry);
+	}
+	if (ferror(file) || *baseline_count == 0)
+		goto out;
+	RTLS_INFO("loaded %u unique IMA baselines from %zu entries\n", HASH_COUNT(*baselines),
+		  *baseline_count);
+	result = 0;
+	goto out;
+
+malformed:
+	RTLS_ERR("invalid IMA baseline at line %zu; expected: <sha256|sha1> <hex-digest> <path>\n",
+		 line_number);
+out:
+	fclose(file);
+	if (result)
+		free_ima_baselines(baselines);
+	return result;
+}
+
+static bool supported_ima_template(const uint8_t *name, size_t size)
+{
+	static const char *templates[] = { "ima-ng", "ima-sig", "ima-buf" };
+	while (size && name[size - 1] == '\0')
+		--size;
+	for (size_t i = 0; i < sizeof(templates) / sizeof(templates[0]); ++i) {
+		if (size == strlen(templates[i]) && !memcmp(name, templates[i], size))
+			return true;
+	}
+	return false;
+}
+
+static const char *event_type_name(uint32_t type)
+{
+	switch (type) {
+	case 0x00000000:
+		return "EV_PREBOOT_CERT";
+	case 0x00000001:
+		return "EV_POST_CODE";
+	case EV_NO_ACTION:
+		return "EV_NO_ACTION";
+	case 0x00000004:
+		return "EV_SEPARATOR";
+	case 0x00000005:
+		return "EV_ACTION";
+	case EV_IPL:
+		return "EV_IPL";
+	case EV_EFI_EVENT_BASE + 0x1U:
+		return "EV_EFI_VARIABLE_DRIVER_CONFIG";
+	case EV_EFI_EVENT_BASE + 0x2U:
+		return "EV_EFI_VARIABLE_BOOT";
+	case EV_EFI_BOOT_SERVICES_APPLICATION:
+		return "EV_EFI_BOOT_SERVICES_APPLICATION";
+	case EV_EFI_EVENT_BASE + 0x4U:
+		return "EV_EFI_BOOT_SERVICES_DRIVER";
+	case EV_EFI_EVENT_BASE + 0x5U:
+		return "EV_EFI_RUNTIME_SERVICES_DRIVER";
+	case EV_EFI_EVENT_BASE + 0x6U:
+		return "EV_EFI_GPT_EVENT";
+	case EV_EFI_EVENT_BASE + 0x7U:
+		return "EV_EFI_ACTION";
+	case EV_EFI_EVENT_BASE + 0x8U:
+		return "EV_EFI_PLATFORM_FIRMWARE_BLOB";
+	case EV_EFI_EVENT_BASE + 0x9U:
+		return "EV_EFI_HANDOFF_TABLES";
+	case EV_EFI_EVENT_BASE + 0xe0U:
+		return "EV_EFI_VARIABLE_AUTHORITY";
+	default:
+		return "UNKNOWN";
+	}
+}
+
+static const char *algorithm_name(uint16_t algorithm)
+{
+	switch (algorithm) {
+	case TPM_ALG_SHA1:
+		return "TPM_ALG_SHA1";
+	case TPM_ALG_SHA256:
+		return "TPM_ALG_SHA256";
+	case TPM_ALG_SHA384:
+		return "TPM_ALG_SHA384";
+	case TPM_ALG_SHA512:
+		return "TPM_ALG_SHA512";
+	default:
+		return "UNKNOWN";
+	}
+}
+
+static void print_digest_hex(const uint8_t *digest, size_t size)
+{
+	for (size_t i = 0; i < size; ++i)
+		printf("%02x", digest[i]);
+}
+
+int cca_verify_ima_log(rats_tls_handle handle, const char *digest_file)
+{
+	uint8_t *data = NULL;
+	size_t size = 0;
+	ima_baseline_t *baselines = NULL;
+	size_t baseline_count = 0;
+	if (digest_file && load_ima_baselines(digest_file, &baselines, &baseline_count))
+		return -1;
+	if (receive_log(handle, CCA_SAMPLE_REQUEST_IMA_LOG, CCA_SAMPLE_MAX_LOG_SIZE, &data,
+			&size)) {
+		RTLS_ERR("failed to receive IMA log\n");
+		free_ima_baselines(&baselines);
+		return -1;
+	}
+
+	cursor_t cursor = { data, size, 0 };
+	size_t entry_count = 0;
+	int result = -1;
+	while (cursor.offset < cursor.size) {
+		if (entry_count >= MAX_IMA_ENTRIES) {
+			RTLS_ERR("IMA log exceeds %u entries\n", MAX_IMA_ENTRIES);
+			goto out;
+		}
+		uint32_t pcr, name_size, template_size;
+		const uint8_t *header_digest, *name, *template_data;
+		if (get_u32(&cursor, &pcr) || get_bytes(&cursor, SHA1_SIZE, &header_digest) ||
+		    get_u32(&cursor, &name_size) || name_size == 0 ||
+		    name_size > MAX_TEMPLATE_NAME || get_bytes(&cursor, name_size, &name) ||
+		    get_u32(&cursor, &template_size) || template_size > MAX_TEMPLATE_DATA ||
+		    get_bytes(&cursor, template_size, &template_data)) {
+			RTLS_ERR("invalid IMA binary log entry at offset %zu\n", cursor.offset);
+			goto out;
+		}
+		if (!supported_ima_template(name, name_size)) {
+			RTLS_ERR("unsupported IMA template: %.*s\n", (int)name_size, name);
+			goto out;
+		}
+		uint8_t calculated_header_digest[SHA1_SIZE];
+		if (sha1(template_data, template_size, calculated_header_digest) ||
+		    memcmp(header_digest, calculated_header_digest, SHA1_SIZE)) {
+			RTLS_ERR("IMA template hash mismatch at entry %zu\n", entry_count);
+			goto out;
+		}
+
+		uint8_t algorithm;
+		const uint8_t *file_digest;
+		const uint8_t *file_path;
+		size_t file_digest_size;
+		size_t file_path_size;
+		if (parse_ima_identity(template_data, template_size, &algorithm, &file_digest,
+				       &file_digest_size, &file_path, &file_path_size)) {
+			RTLS_ERR("failed to parse IMA identity at entry %zu\n", entry_count);
+			goto out;
+		}
+		if (baselines && !(file_path_size == strlen("boot_aggregate") &&
+				   !memcmp(file_path, "boot_aggregate", file_path_size))) {
+			uint8_t key[1 + 64 + MAX_IMA_PATH];
+			size_t key_size;
+			ima_baseline_t *baseline;
+			if (build_ima_key(algorithm, file_digest, file_digest_size, file_path,
+					  file_path_size, key, sizeof(key), &key_size))
+				goto out;
+			HASH_FIND(hh, baselines, key, key_size, baseline);
+			if (!baseline) {
+				RTLS_ERR("IMA baseline mismatch at entry %zu: %.*s\n", entry_count,
+					 (int)file_path_size, file_path);
+				goto out;
+			}
+		}
+
+		++entry_count;
+	}
+
+	if (entry_count == 0) {
+		RTLS_ERR("IMA log is empty\n");
+		goto out;
+	}
+	RTLS_INFO("IMA log verification passed (%zu entries)%s\n", entry_count,
+		  baselines ? " with application baselines" : "");
+	result = 0;
+out:
+	free_ima_baselines(&baselines);
+	free(data);
+	return result;
+}
+
+static size_t digest_size(uint16_t algorithm)
+{
+	switch (algorithm) {
+	case TPM_ALG_SHA1:
+		return 20;
+	case TPM_ALG_SHA256:
+		return 32;
+	case TPM_ALG_SHA384:
+		return 48;
+	case TPM_ALG_SHA512:
+		return 64;
+	default:
+		return 0;
+	}
+}
+
+int cca_verify_boot_log(rats_tls_handle handle, bool dump_boot_log, bool eventlog_dump,
+			const char *firmware_file)
+{
+	uint8_t *ccel_table = NULL;
+	size_t ccel_table_size = 0;
+	uint8_t *data = NULL;
+	size_t size = 0;
+	firmware_state_t firmware_state;
+	memset(&firmware_state, 0, sizeof(firmware_state));
+	if (!cca_sample_realm_measurements.valid ||
+	    receive_log(handle, CCA_SAMPLE_REQUEST_CCEL_TABLE, 1024U * 1024U, &ccel_table,
+			&ccel_table_size)) {
+		RTLS_ERR("failed to receive CCA CCEL table\n");
+		free(ccel_table);
+		return -1;
+	}
+	RTLS_INFO("received CCA CCEL table (%zu bytes)\n", ccel_table_size);
+	if (dump_boot_log)
+		dump_binary_file("ccel.bin", ccel_table, ccel_table_size);
+	ccel_table_info_t ccel_info;
+	if (parse_ccel_table(ccel_table, ccel_table_size, &ccel_info))
+		goto out;
+	if (eventlog_dump)
+		print_ccel_table(ccel_table, ccel_table_size, &ccel_info);
+
+	if (receive_log(handle, CCA_SAMPLE_REQUEST_EVENT_LOG, 5U * 1024U * 1024U, &data, &size)) {
+		RTLS_ERR("failed to receive CCA event log\n");
+		free(ccel_table);
+		free(data);
+		return -1;
+	}
+	RTLS_INFO("received CCA event log (%zu bytes)\n", size);
+	if (dump_boot_log) {
+		dump_binary_file("event_log.bin", data, size);
+		dump_binary_file("boot_log.bin", data, size);
+	}
+
+	cursor_t cursor = { data, size, 0 };
+	uint8_t replay[2][SHA256_SIZE] = { 0 };
+	bool used[2] = { false };
+	size_t entry_count = 0;
+	int result = -1;
+	if (eventlog_dump)
+		printf("=> Read Event Log Data - Address: 0x%lx(0x%lx)\n",
+		       (unsigned long)ccel_info.log_address, (unsigned long)size);
+	while (cursor.offset < cursor.size) {
+		size_t entry_start = cursor.offset;
+		uint32_t registry, event_type, digest_count, event_size;
+		if (get_u32(&cursor, &registry) || get_u32(&cursor, &event_type))
+			goto malformed;
+
+		/*
+		 * Match GTA's eventlog-rs parser: the first eight bytes of each entry
+		 * form a stop flag. CCEL buffers may be padded with either 0xff or 0x00.
+		 */
+		if ((registry == UINT32_MAX && event_type == UINT32_MAX) ||
+		    (registry == 0 && event_type == 0))
+			break;
+
+		/* The first entry is the legacy TCG_PCR_EVENT carrying Spec ID Event03. */
+		if (entry_count == 0 && event_type == EV_NO_ACTION) {
+			const uint8_t *legacy_digest, *spec_event;
+			uint32_t spec_event_size;
+			if (get_bytes(&cursor, SHA1_SIZE, &legacy_digest) ||
+			    get_u32(&cursor, &spec_event_size) ||
+			    spec_event_size > MAX_EVENT_DATA ||
+			    get_bytes(&cursor, spec_event_size, &spec_event) ||
+			    spec_event_size < 29 || memcmp(spec_event, "Spec ID Event03", 15)) {
+				goto malformed;
+			}
+			cursor_t spec = { spec_event, spec_event_size, 24 };
+			uint32_t algorithm_count;
+			if (get_u32(&spec, &algorithm_count) || algorithm_count > 16)
+				goto malformed;
+			for (uint32_t i = 0; i < algorithm_count; ++i) {
+				uint16_t algorithm, size_of_digest;
+				if (get_u16(&spec, &algorithm) || get_u16(&spec, &size_of_digest) ||
+				    digest_size(algorithm) != size_of_digest)
+					goto malformed;
+			}
+			const uint8_t *vendor_size_data, *vendor;
+			if (get_bytes(&spec, 1, &vendor_size_data) ||
+			    get_bytes(&spec, *vendor_size_data, &vendor))
+				goto malformed;
+			if (eventlog_dump) {
+				printf("\n==== CCA Event Log Entry - %zu [0x%lx] ====\n",
+				       entry_count,
+				       (unsigned long)(ccel_info.log_address + entry_start));
+				printf("REM               : %u\n", registry > 0 ? registry - 1 : 0);
+				printf("Type              : 0x%x (%s)\n", event_type,
+				       event_type_name(event_type));
+				printf("Algorithms Number : %u\n", algorithm_count);
+				printf("RAW DATA: ----------------------------------------------\n");
+				print_hex_dump_with_ascii(cursor.data + entry_start,
+							  cursor.offset - entry_start,
+							  ccel_info.log_address + entry_start);
+				printf("RAW DATA: ----------------------------------------------\n");
+			}
+			(void)legacy_digest;
+			(void)vendor;
+			++entry_count;
+			continue;
+		}
+
+		if (get_u32(&cursor, &digest_count) || digest_count == 0 || digest_count > 16)
+			goto malformed;
+		const uint8_t *sha256_digest = NULL;
+		uint16_t first_algorithm = 0;
+		const uint8_t *first_digest = NULL;
+		size_t first_digest_size = 0;
+		for (uint32_t i = 0; i < digest_count; ++i) {
+			uint16_t algorithm;
+			const uint8_t *digest;
+			if (get_u16(&cursor, &algorithm))
+				goto malformed;
+			size_t current_size = digest_size(algorithm);
+			if (!current_size || get_bytes(&cursor, current_size, &digest))
+				goto malformed;
+			if (i == 0) {
+				first_algorithm = algorithm;
+				first_digest = digest;
+				first_digest_size = current_size;
+			}
+			if (algorithm == TPM_ALG_SHA256)
+				sha256_digest = digest;
+		}
+		const uint8_t *event;
+		if (get_u32(&cursor, &event_size) || event_size > MAX_EVENT_DATA ||
+		    get_bytes(&cursor, event_size, &event))
+			goto malformed;
+		if (eventlog_dump) {
+			printf("\n==== CCA Event Log Entry - %zu [0x%lx] ====\n", entry_count,
+			       (unsigned long)(ccel_info.log_address + entry_start));
+			printf("REM               : %u\n", registry > 0 ? registry - 1 : 0);
+			printf("Type              : 0x%x (%s)\n", event_type,
+			       event_type_name(event_type));
+			printf("Length            : %zu\n", cursor.offset - entry_start);
+			printf("Algorithms ID     : %u (%s)\n", first_algorithm,
+			       algorithm_name(first_algorithm));
+			if (first_digest) {
+				printf("Digest[0]         : ");
+				print_digest_hex(first_digest, first_digest_size);
+				printf("\n");
+			}
+			printf("RAW DATA: ----------------------------------------------\n");
+			print_hex_dump_with_ascii(cursor.data + entry_start, cursor.offset - entry_start,
+						  ccel_info.log_address + entry_start);
+			printf("RAW DATA: ----------------------------------------------\n");
+		}
+
+		/* GTA CCA boot-log policy validates measurement registries 1 and 2. */
+		if (registry >= 1 && registry <= 2 && sha256_digest) {
+			uint8_t next[SHA256_SIZE];
+			if (sha256_two(replay[registry - 1], sha256_digest, next))
+				goto out;
+			memcpy(replay[registry - 1], next, sizeof(next));
+			used[registry - 1] = true;
+		}
+		if (firmware_file && sha256_digest &&
+		    capture_firmware_state(&firmware_state, event_type, sha256_digest, event,
+					   event_size))
+			goto out;
+		++entry_count;
+	}
+
+	for (size_t i = 0; i < 2; ++i) {
+		if (!used[i] || cca_sample_realm_measurements.rem_size[i] != SHA256_SIZE ||
+		    memcmp(replay[i], cca_sample_realm_measurements.rem[i], SHA256_SIZE)) {
+			RTLS_ERR("boot log replay does not match CCA REM%zu\n", i);
+			goto out;
+		}
+		RTLS_INFO("boot log replay matched CCA REM%zu\n", i);
+	}
+	if (firmware_file && verify_firmware_state(firmware_file, &firmware_state))
+		goto out;
+	RTLS_INFO("CCA boot log verification passed (%zu entries)\n", entry_count);
+	result = 0;
+	goto out;
+
+malformed:
+	RTLS_ERR("invalid CCA boot log entry at offset %zu\n", cursor.offset);
+out:
+	free(firmware_state.efi_images);
+	free(ccel_table);
+	free(data);
+	return result;
+}
