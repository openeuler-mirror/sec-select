diff --git a/samples/cca-common/cca_policy.c b/samples/cca-common/cca_policy.c
new file mode 100644
index 0000000..3648a1e
--- /dev/null
+++ b/samples/cca-common/cca_policy.c
@@ -0,0 +1,350 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <ctype.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <rats-tls/log.h>
+#include "cca_policy.h"
+#include "cca_sample.h"
+
+#define MAX_PLATFORM_BASELINES 100000U
+#define MAX_JSON_FILE_SIZE     (16U * 1024U * 1024U)
+#define MAX_JSON_FIELD	       512U
+
+typedef struct {
+	char firmware_name[MAX_JSON_FIELD];
+	char measurement[MAX_JSON_FIELD];
+	char firmware_version[MAX_JSON_FIELD];
+	char hash_algorithm[MAX_JSON_FIELD];
+	char signer_id[MAX_JSON_FIELD];
+	bool has_signer_id;
+	bool matched;
+} platform_baseline_t;
+
+static char *skip_space(char *text)
+{
+	while (*text && isspace((unsigned char)*text))
+		++text;
+	return text;
+}
+
+static const char *skip_const_space(const char *text)
+{
+	while (*text && isspace((unsigned char)*text))
+		++text;
+	return text;
+}
+
+static bool token_is_wildcard(const char *token)
+{
+	return !token || token[0] == '\0' || !strcmp(token, "-") || !strcmp(token, "*");
+}
+
+static bool text_matches(const char *expected, const char *actual)
+{
+	return token_is_wildcard(expected) || !strcmp(expected, actual);
+}
+
+static bool hash_algorithm_matches(const char *expected, const char *actual)
+{
+	if (text_matches(expected, actual))
+		return true;
+	if (!strcmp(expected, "sha256") && !strcmp(actual, "sha-256"))
+		return true;
+	if (!strcmp(expected, "sha384") && !strcmp(actual, "sha-384"))
+		return true;
+	if (!strcmp(expected, "sha512") && !strcmp(actual, "sha-512"))
+		return true;
+	return false;
+}
+
+static bool bytes_match_hex(const char *expected, const uint8_t *actual, size_t actual_size)
+{
+	if (token_is_wildcard(expected))
+		return true;
+	uint8_t parsed[CCA_SAMPLE_MAX_COMPONENT_DIGEST];
+	size_t parsed_size = 0;
+	if (cca_sample_parse_hex(expected, parsed, sizeof(parsed), &parsed_size))
+		return false;
+	return parsed_size == actual_size && !memcmp(parsed, actual, actual_size);
+}
+
+static char *read_file(const char *path)
+{
+	FILE *file = fopen(path, "rb");
+	if (!file) {
+		RTLS_ERR("failed to open CCA platform baseline %s: %s\n", path, strerror(errno));
+		return NULL;
+	}
+	if (fseek(file, 0, SEEK_END)) {
+		RTLS_ERR("failed to seek CCA platform baseline %s\n", path);
+		fclose(file);
+		return NULL;
+	}
+	long size = ftell(file);
+	if (size <= 0 || size > (long)MAX_JSON_FILE_SIZE) {
+		RTLS_ERR("CCA platform baseline %s size %ld is invalid\n", path, size);
+		fclose(file);
+		return NULL;
+	}
+	rewind(file);
+	char *content = malloc((size_t)size + 1);
+	if (!content) {
+		fclose(file);
+		return NULL;
+	}
+	size_t got = fread(content, 1, (size_t)size, file);
+	if (got != (size_t)size) {
+		RTLS_ERR("failed to read CCA platform baseline %s\n", path);
+		free(content);
+		fclose(file);
+		return NULL;
+	}
+	content[got] = '\0';
+	fclose(file);
+	return content;
+}
+
+static char *find_json_key(char *json, const char *key)
+{
+	char pattern[128];
+	if (snprintf(pattern, sizeof(pattern), "\"%s\"", key) >= (int)sizeof(pattern))
+		return NULL;
+	return strstr(json, pattern);
+}
+
+static int extract_json_string(const char *object, const char *key, char *output, size_t capacity)
+{
+	char pattern[128];
+	if (snprintf(pattern, sizeof(pattern), "\"%s\"", key) >= (int)sizeof(pattern))
+		return -1;
+	const char *pos = strstr(object, pattern);
+	if (!pos)
+		return 1;
+	pos += strlen(pattern);
+	pos = skip_const_space(pos);
+	if (*pos != ':')
+		return -1;
+	pos = skip_const_space(pos + 1);
+	if (*pos != '"')
+		return -1;
+	++pos;
+
+	size_t written = 0;
+	while (*pos && *pos != '"') {
+		if (*pos == '\\') {
+			++pos;
+			if (!*pos)
+				return -1;
+		}
+		if (written + 1 >= capacity)
+			return -1;
+		output[written++] = *pos++;
+	}
+	if (*pos != '"')
+		return -1;
+	output[written] = '\0';
+	return 0;
+}
+
+static int extract_required_json_string(const char *object, const char *key, char *output,
+					size_t capacity)
+{
+	int result = extract_json_string(object, key, output, capacity);
+	if (result == 1)
+		RTLS_ERR("CCA platform baseline component missing required field '%s'\n", key);
+	else if (result)
+		RTLS_ERR("CCA platform baseline component has invalid field '%s'\n", key);
+	return result;
+}
+
+static int extract_first_available_string(const char *object, const char *first_key,
+					  const char *second_key, char *output, size_t capacity)
+{
+	int result = extract_json_string(object, first_key, output, capacity);
+	if (result == 0 || result < 0)
+		return result;
+	return extract_required_json_string(object, second_key, output, capacity);
+}
+
+static char *find_measure_array(char *json)
+{
+	char *key = find_json_key(json, "measure_value");
+	if (!key)
+		key = find_json_key(json, "measure-values");
+	if (!key)
+		key = find_json_key(json, "measure_values");
+	if (!key)
+		return NULL;
+	char *array = strchr(key, '[');
+	return array ? array + 1 : NULL;
+}
+
+static int load_platform_baselines(const char *path, platform_baseline_t **baselines,
+				   size_t *baseline_count)
+{
+	char *json = read_file(path);
+	if (!json)
+		return -1;
+
+	char *array = find_measure_array(json);
+	if (!array) {
+		RTLS_ERR("CCA platform baseline JSON must contain measure_value array\n");
+		free(json);
+		return -1;
+	}
+
+	platform_baseline_t *entries = NULL;
+	size_t count = 0;
+	char *pos = array;
+	for (;;) {
+		pos = skip_space(pos);
+		if (*pos == ']')
+			break;
+		if (*pos == ',') {
+			++pos;
+			continue;
+		}
+		if (*pos != '{') {
+			RTLS_ERR("invalid CCA platform baseline JSON near offset %td\n",
+				 pos - json);
+			free(entries);
+			free(json);
+			return -1;
+		}
+
+		char *object_start = pos;
+		char *object_end = strchr(object_start, '}');
+		if (!object_end) {
+			RTLS_ERR("unterminated CCA platform baseline component object\n");
+			free(entries);
+			free(json);
+			return -1;
+		}
+		*object_end = '\0';
+		if (count >= MAX_PLATFORM_BASELINES) {
+			RTLS_ERR("CCA platform baseline exceeds %u entries\n",
+				 MAX_PLATFORM_BASELINES);
+			free(entries);
+			free(json);
+			return -1;
+		}
+		platform_baseline_t *next = realloc(entries, (count + 1) * sizeof(*entries));
+		if (!next) {
+			free(entries);
+			free(json);
+			return -1;
+		}
+		entries = next;
+		memset(&entries[count], 0, sizeof(entries[count]));
+
+		if (extract_first_available_string(object_start, "firware_name", "firmware_name",
+						   entries[count].firmware_name,
+						   sizeof(entries[count].firmware_name)) ||
+		    extract_required_json_string(object_start, "measurement",
+						 entries[count].measurement,
+						 sizeof(entries[count].measurement)) ||
+		    extract_first_available_string(object_start, "firware_version",
+						   "firmware_version",
+						   entries[count].firmware_version,
+						   sizeof(entries[count].firmware_version)) ||
+		    extract_required_json_string(object_start, "hash_algorithm",
+						 entries[count].hash_algorithm,
+						 sizeof(entries[count].hash_algorithm))) {
+			free(entries);
+			free(json);
+			return -1;
+		}
+
+		int signer_result = extract_json_string(object_start, "signer_id",
+							entries[count].signer_id,
+							sizeof(entries[count].signer_id));
+		if (signer_result < 0) {
+			RTLS_ERR("CCA platform baseline component has invalid field 'signer_id'\n");
+			free(entries);
+			free(json);
+			return -1;
+		}
+		entries[count].has_signer_id = signer_result == 0;
+		++count;
+		pos = object_end + 1;
+	}
+
+	free(json);
+	if (count == 0) {
+		RTLS_ERR("CCA platform baseline JSON has no measure_value entries\n");
+		free(entries);
+		return -1;
+	}
+	*baselines = entries;
+	*baseline_count = count;
+	RTLS_INFO("loaded %zu CCA platform JSON baselines\n", count);
+	return 0;
+}
+
+static bool component_matches_baseline(const cca_sample_sw_component_t *component,
+				       const platform_baseline_t *baseline)
+{
+	return text_matches(baseline->firmware_name, component->component_type) &&
+	       hash_algorithm_matches(baseline->hash_algorithm, component->hash_algorithm) &&
+	       bytes_match_hex(baseline->measurement, component->measurement,
+			       component->measurement_size) &&
+	       text_matches(baseline->firmware_version, component->version) &&
+	       (!baseline->has_signer_id ||
+		bytes_match_hex(baseline->signer_id, component->signer_id,
+				component->signer_id_size));
+}
+
+int cca_verify_platform_file(const char *path)
+{
+	if (!cca_sample_platform_measurements.valid) {
+		RTLS_ERR("CCA platform claims are unavailable for platform baseline verification\n");
+		return -1;
+	}
+
+	platform_baseline_t *baselines = NULL;
+	size_t baseline_count = 0;
+	if (load_platform_baselines(path, &baselines, &baseline_count))
+		return -1;
+
+	int result = -1;
+	for (size_t i = 0; i < cca_sample_platform_measurements.component_count; ++i) {
+		const cca_sample_sw_component_t *component =
+			&cca_sample_platform_measurements.components[i];
+		bool matched = false;
+		for (size_t j = 0; j < baseline_count; ++j) {
+			if (text_matches(baselines[j].firmware_name, component->component_type)) {
+				if (!component_matches_baseline(component, &baselines[j])) {
+					RTLS_ERR("CCA platform baseline mismatch for component '%s'\n",
+						 component->component_type);
+					goto out;
+				}
+				baselines[j].matched = true;
+				matched = true;
+				break;
+			}
+		}
+		if (!matched) {
+			RTLS_ERR("CCA platform baseline missing component '%s'\n",
+				 component->component_type);
+			goto out;
+		}
+	}
+
+	for (size_t i = 0; i < baseline_count; ++i) {
+		if (!baselines[i].matched) {
+			RTLS_ERR("CCA platform baseline component '%s' was not found in token\n",
+				 baselines[i].firmware_name);
+			goto out;
+		}
+	}
+
+	RTLS_INFO("CCA platform JSON baseline verification passed (%zu entries)\n",
+		  baseline_count);
+	result = 0;
+out:
+	free(baselines);
+	return result;
+}
