index 0000000..8f4c620
--- /dev/null
+++ b/samples/cca-server/server.c
@@ -0,0 +1,324 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <arpa/inet.h>
+#include <errno.h>
+#include <getopt.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <rats-tls/api.h>
+#include <rats-tls/log.h>
+#include "cca_sample.h"
+
+#define DEFAULT_IP	 "0.0.0.0"
+#define DEFAULT_PORT	 1234
+#define DEFAULT_IMA_LOG	 "/sys/kernel/security/ima/binary_runtime_measurements"
+#define DEFAULT_CCEL_TABLE "/sys/firmware/acpi/tables/CCEL"
+#define DEFAULT_BOOT_LOG "/sys/firmware/acpi/tables/data/CCEL"
+
+rats_tls_log_level_t global_log_level = RATS_TLS_LOG_LEVEL_DEFAULT;
+
+static void usage(const char *program)
+{
+	printf("Usage: %s [options]\n"
+	       "        --ip/-i value             listening IPv4 address (default 0.0.0.0)\n"
+	       "        --port/-p value           listening TCP port (default 1234)\n"
+	       "        --mutual/-m               verify client CCA evidence\n"
+	       "        --once/-1                 exit after one connection\n"
+	       "        --ima-log value           IMA binary log path\n"
+	       "        --ccel-table value        CCEL ACPI table path\n"
+	       "        --boot-log value          CCA event log path\n"
+	       "        --log-level/-l value      debug|info|warn|error|fatal|off\n",
+	       program);
+	cca_sample_print_policy_options();
+	puts("        --help/-h                 show this help");
+}
+
+static int configure_policy(int option, const char *value)
+{
+	switch (option) {
+	case 1000:
+		cca_sample_policy.realm_profile = value;
+		return 0;
+	case 1001:
+		cca_sample_policy.platform_profile = value;
+		return 0;
+	case 1002:
+		return cca_sample_parse_hex(value, cca_sample_policy.rim,
+					    sizeof(cca_sample_policy.rim),
+					    &cca_sample_policy.rim_size);
+	case 1003:
+		if (cca_sample_parse_hex(value, cca_sample_policy.implementation_id,
+					 sizeof(cca_sample_policy.implementation_id),
+					 &cca_sample_policy.implementation_id_size))
+			return -1;
+		return cca_sample_policy.implementation_id_size == 32 ? 0 : -1;
+	case 1004:
+		if (cca_sample_parse_hex(value, cca_sample_policy.instance_id,
+					 sizeof(cca_sample_policy.instance_id),
+					 &cca_sample_policy.instance_id_size))
+			return -1;
+		return cca_sample_policy.instance_id_size == 33 ? 0 : -1;
+	default:
+		return -1;
+	}
+}
+
+static int send_file(rats_tls_handle handle, const char *path)
+{
+	FILE *file = fopen(path, "rb");
+	if (!file) {
+		RTLS_ERR("failed to open %s: %s\n", path, strerror(errno));
+		return -1;
+	}
+
+	size_t capacity = 64U * 1024U;
+	uint8_t *data = malloc(capacity);
+	if (!data) {
+		fclose(file);
+		return -1;
+	}
+
+	size_t length = 0;
+	for (;;) {
+		if (length == capacity) {
+			if (capacity >= CCA_SAMPLE_MAX_LOG_SIZE) {
+				RTLS_ERR("log file %s exceeds maximum %u\n", path,
+					 CCA_SAMPLE_MAX_LOG_SIZE);
+				free(data);
+				fclose(file);
+				return -1;
+			}
+			size_t next_capacity = capacity * 2U;
+			if (next_capacity > CCA_SAMPLE_MAX_LOG_SIZE)
+				next_capacity = CCA_SAMPLE_MAX_LOG_SIZE;
+			uint8_t *next = realloc(data, next_capacity);
+			if (!next) {
+				free(data);
+				fclose(file);
+				return -1;
+			}
+			data = next;
+			capacity = next_capacity;
+		}
+
+		size_t read_size = fread(data + length, 1, capacity - length, file);
+		length += read_size;
+		if (read_size == 0) {
+			if (ferror(file)) {
+				RTLS_ERR("failed to read %s: %s\n", path, strerror(errno));
+				free(data);
+				fclose(file);
+				return -1;
+			}
+			break;
+		}
+	}
+	fclose(file);
+
+	if (length == 0) {
+		RTLS_ERR("log file %s is empty\n", path);
+		free(data);
+		return -1;
+	}
+
+	RTLS_INFO("sending log file %s (%zu bytes)\n", path, length);
+	int result = cca_sample_send_frame(handle, data, length);
+	if (result)
+		RTLS_ERR("failed to send log file %s\n", path);
+	free(data);
+	return result;
+}
+
+static int serve_connection(int connection, bool mutual, rats_tls_log_level_t log_level,
+			    const char *ima_log, const char *ccel_table, const char *boot_log)
+{
+	rats_tls_conf_t config = {
+		.flags = RATS_TLS_CONF_FLAGS_SERVER,
+		.log_level = log_level,
+		.cert_algo = RATS_TLS_CERT_ALGO_DEFAULT,
+	};
+	snprintf(config.attester_type, sizeof(config.attester_type), "cca");
+	snprintf(config.verifier_type, sizeof(config.verifier_type), "cca");
+	snprintf(config.tls_type, sizeof(config.tls_type), "openssl");
+	snprintf(config.crypto_type, sizeof(config.crypto_type), "openssl");
+	if (mutual)
+		config.flags |= RATS_TLS_CONF_FLAGS_MUTUAL;
+
+	rats_tls_handle handle = NULL;
+	if (rats_tls_init(&config, &handle) != RATS_TLS_ERR_NONE)
+		goto error;
+	if (mutual && rats_tls_set_verification_callback(&handle, cca_sample_verify_callback) !=
+			      RATS_TLS_ERR_NONE)
+		goto error;
+	if (rats_tls_negotiate(handle, connection) != RATS_TLS_ERR_NONE)
+		goto error;
+
+	for (;;) {
+		uint8_t request[4096];
+		size_t request_size = 0;
+		if (cca_sample_receive_frame(handle, request, sizeof(request), &request_size)) {
+			RTLS_ERR("failed to receive a valid CCA sample frame\n");
+			goto error;
+		}
+		if (request_size == strlen(CCA_SAMPLE_REQUEST_IMA_LOG) &&
+		    !memcmp(request, CCA_SAMPLE_REQUEST_IMA_LOG, request_size)) {
+			RTLS_INFO("received IMA log request\n");
+			if (send_file(handle, ima_log))
+				goto error;
+			continue;
+		}
+		if (request_size == strlen(CCA_SAMPLE_REQUEST_BOOT_LOG) &&
+		    !memcmp(request, CCA_SAMPLE_REQUEST_BOOT_LOG, request_size)) {
+			RTLS_INFO("received boot log request\n");
+			if (send_file(handle, boot_log))
+				goto error;
+			continue;
+		}
+		if (request_size == strlen(CCA_SAMPLE_REQUEST_CCEL_TABLE) &&
+		    !memcmp(request, CCA_SAMPLE_REQUEST_CCEL_TABLE, request_size)) {
+			RTLS_INFO("received CCEL table request\n");
+			if (send_file(handle, ccel_table))
+				goto error;
+			continue;
+		}
+		if (request_size == strlen(CCA_SAMPLE_REQUEST_EVENT_LOG) &&
+		    !memcmp(request, CCA_SAMPLE_REQUEST_EVENT_LOG, request_size)) {
+			RTLS_INFO("received event log request\n");
+			if (send_file(handle, boot_log))
+				goto error;
+			continue;
+		}
+		if (request_size == strlen(CCA_SAMPLE_ATTESTATION_PASS) &&
+		    !memcmp(request, CCA_SAMPLE_ATTESTATION_PASS, request_size)) {
+			if (cca_sample_send_frame(handle, CCA_SAMPLE_ATTESTATION_PASS,
+						  strlen(CCA_SAMPLE_ATTESTATION_PASS)))
+				goto error;
+			break;
+		}
+		printf("CCA client: %.*s\n", (int)request_size, (const char *)request);
+		if (cca_sample_send_frame(handle, request, request_size))
+			goto error;
+	}
+
+	rats_tls_cleanup(handle);
+	return 0;
+error:
+	RTLS_ERR("CCA RA-TLS server connection failed\n");
+	if (handle)
+		rats_tls_cleanup(handle);
+	return -1;
+}
+
+int main(int argc, char **argv)
+{
+	const char *ip = DEFAULT_IP;
+	int port = DEFAULT_PORT;
+	bool mutual = false;
+	bool once = false;
+	const char *ima_log = DEFAULT_IMA_LOG;
+	const char *ccel_table = DEFAULT_CCEL_TABLE;
+	const char *boot_log = DEFAULT_BOOT_LOG;
+	rats_tls_log_level_t log_level = RATS_TLS_LOG_LEVEL_INFO;
+	static const struct option options[] = {
+		{ "ip", required_argument, NULL, 'i' },
+		{ "port", required_argument, NULL, 'p' },
+		{ "mutual", no_argument, NULL, 'm' },
+		{ "once", no_argument, NULL, '1' },
+		{ "log-level", required_argument, NULL, 'l' },
+		{ "ima-log", required_argument, NULL, 1005 },
+		{ "boot-log", required_argument, NULL, 1006 },
+		{ "ccel-table", required_argument, NULL, 1007 },
+		{ "realm-profile", required_argument, NULL, 1000 },
+		{ "platform-profile", required_argument, NULL, 1001 },
+		{ "rim", required_argument, NULL, 1002 },
+		{ "implementation-id", required_argument, NULL, 1003 },
+		{ "instance-id", required_argument, NULL, 1004 },
+		{ "help", no_argument, NULL, 'h' },
+		{ 0, 0, 0, 0 },
+	};
+
+	int option;
+	while ((option = getopt_long(argc, argv, "i:p:m1l:h", options, NULL)) != -1) {
+		switch (option) {
+		case 'i':
+			ip = optarg;
+			break;
+		case 'p':
+			port = atoi(optarg);
+			break;
+		case 'm':
+			mutual = true;
+			break;
+		case '1':
+			once = true;
+			break;
+		case 'l':
+			if (cca_sample_parse_log_level(optarg, &log_level))
+				goto invalid;
+			break;
+		case 'h':
+			usage(argv[0]);
+			return 0;
+		default:
+			if (option == 1005) {
+				ima_log = optarg;
+				break;
+			}
+			if (option == 1006) {
+				boot_log = optarg;
+				break;
+			}
+			if (option == 1007) {
+				ccel_table = optarg;
+				break;
+			}
+			if (configure_policy(option, optarg))
+				goto invalid;
+			break;
+		}
+	}
+	if (port <= 0 || port > 65535)
+		goto invalid;
+	global_log_level = log_level;
+	signal(SIGPIPE, SIG_IGN);
+
+	int listen_fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (listen_fd < 0) {
+		RTLS_ERR("socket failed: %s\n", strerror(errno));
+		return 1;
+	}
+	int reuse = 1;
+	setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+	struct sockaddr_in address = {
+		.sin_family = AF_INET,
+		.sin_port = htons((uint16_t)port),
+	};
+	if (inet_pton(AF_INET, ip, &address.sin_addr) != 1 ||
+	    bind(listen_fd, (struct sockaddr *)&address, sizeof(address)) || listen(listen_fd, 8)) {
+		RTLS_ERR("failed to listen on %s:%d: %s\n", ip, port, strerror(errno));
+		close(listen_fd);
+		return 1;
+	}
+
+	RTLS_INFO("CCA RA-TLS server listening on %s:%d\n", ip, port);
+	do {
+		int connection = accept(listen_fd, NULL, NULL);
+		if (connection < 0) {
+			if (errno == EINTR)
+				continue;
+			RTLS_ERR("accept failed: %s\n", strerror(errno));
+			break;
+		}
+		serve_connection(connection, mutual, log_level, ima_log, ccel_table, boot_log);
+		close(connection);
+	} while (!once);
+
+	close(listen_fd);
+	return 0;
+invalid:
+	usage(argv[0]);
+	return 1;
+}
diff --git a/scripts/cca_collect_baselines.py b/scripts/cca_collect_baselines.py
new file mode 100755
index 0000000..ebd4f5c
--- /dev/null
+++ b/scripts/cca_collect_baselines.py
@@ -0,0 +1,222 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+import argparse
+import json
+import os
+import re
+import struct
+import subprocess
+import sys
+from pathlib import Path
+
+TPM_ALG_SHA1 = 0x0004
+TPM_ALG_SHA256 = 0x000B
+TPM_ALG_SHA384 = 0x000C
+TPM_ALG_SHA512 = 0x000D
+EV_NO_ACTION = 0x00000003
+
+
+def digest_size(algorithm):
+    return {
+        TPM_ALG_SHA1: 20,
+        TPM_ALG_SHA256: 32,
+        TPM_ALG_SHA384: 48,
+        TPM_ALG_SHA512: 64,
+    }.get(algorithm, 0)
+
+
+def clean_value(value):
+    value = value.strip()
+    return "-" if not value or value == "<not present>" else value
+
+
+def parse_platform_baseline(text):
+    components = []
+    current = None
+    field_pattern = re.compile(r"^\s*(type|measurement|version|signer ID|hash algorithm):\s*(.*)$")
+
+    for line in text.splitlines():
+        if line.startswith("CCA software component["):
+            if current:
+                components.append(current)
+            current = {
+                "type": "-",
+                "measurement": "-",
+                "version": "-",
+                "signer ID": "-",
+                "hash algorithm": "-",
+            }
+            continue
+        if not current:
+            continue
+        match = field_pattern.match(line)
+        if match:
+            current[match.group(1)] = clean_value(match.group(2))
+
+    if current:
+        components.append(current)
+
+    baseline = {"measure_value": []}
+    for component in components:
+        entry = {
+            "firware_name": component["type"],
+            "measurement": component["measurement"],
+            "firware_version": component["version"],
+            "hash_algorithm": component["hash algorithm"],
+        }
+        if component["signer ID"] != "-":
+            entry["signer_id"] = component["signer ID"]
+        baseline["measure_value"].append(entry)
+    return json.dumps(baseline, indent=2), len(components)
+
+
+def require(cursor, size, what):
+    if cursor["offset"] + size > len(cursor["data"]):
+        raise ValueError(f"truncated boot log while reading {what} at offset {cursor['offset']}")
+    start = cursor["offset"]
+    cursor["offset"] += size
+    return cursor["data"][start : start + size]
+
+
+def get_u16(cursor, what):
+    return struct.unpack("<H", require(cursor, 2, what))[0]
+
+
+def get_u32(cursor, what):
+    return struct.unpack("<I", require(cursor, 4, what))[0]
+
+
+def parse_firmware_baseline(path):
+    data = Path(path).read_bytes()
+    cursor = {"data": data, "offset": 0}
+    entries = []
+    entry_count = 0
+
+    while cursor["offset"] < len(data):
+        registry = get_u32(cursor, "registry")
+        event_type = get_u32(cursor, "event type")
+
+        if (registry == 0xFFFFFFFF and event_type == 0xFFFFFFFF) or (
+            registry == 0 and event_type == 0
+        ):
+            break
+
+        if entry_count == 0 and event_type == EV_NO_ACTION:
+            require(cursor, 20, "legacy digest")
+            event_size = get_u32(cursor, "spec event size")
+            spec = require(cursor, event_size, "spec event")
+            if len(spec) < 29 or not spec.startswith(b"Spec ID Event03"):
+                raise ValueError("first boot log entry is not Spec ID Event03")
+            entry_count += 1
+            continue
+
+        digest_count = get_u32(cursor, "digest count")
+        sha256_digest = None
+        for _ in range(digest_count):
+            algorithm = get_u16(cursor, "digest algorithm")
+            size = digest_size(algorithm)
+            if not size:
+                raise ValueError(f"unsupported digest algorithm 0x{algorithm:04x}")
+            digest = require(cursor, size, "digest")
+            if algorithm == TPM_ALG_SHA256:
+                sha256_digest = digest
+
+        event_size = get_u32(cursor, "event size")
+        event = require(cursor, event_size, "event")
+        desc = ""
+        try:
+            decoded = event.decode("utf-8", errors="ignore").strip("\x00\r\n\t ")
+            if decoded and all(ch.isprintable() or ch.isspace() for ch in decoded):
+                desc = decoded.splitlines()[0][:120]
+        except UnicodeDecodeError:
+            desc = ""
+
+        if sha256_digest:
+            if desc:
+                entries.append(f"{registry} {sha256_digest.hex()} {desc}")
+            else:
+                entries.append(f"{registry} {sha256_digest.hex()}")
+        entry_count += 1
+
+    lines = ["# <registry> <sha256-hex> [event-desc-substring]"]
+    lines.extend(entries)
+    return lines, len(entries)
+
+
+def run_client(args):
+    command = [
+        args.client,
+        "--ip",
+        args.ip,
+        "--port",
+        str(args.port),
+        "--message",
+        args.message,
+        "--bootlog",
+        "--dump-bootlog",
+        "--log-level",
+        args.log_level,
+    ]
+    if args.mutual:
+        command.append("--mutual")
+    print("running:", " ".join(command), file=sys.stderr)
+    completed = subprocess.run(command, text=True, capture_output=True, cwd=args.workdir)
+    sys.stderr.write(completed.stdout)
+    sys.stderr.write(completed.stderr)
+    if completed.returncode != 0:
+        raise RuntimeError(f"cca-client failed with exit code {completed.returncode}")
+    return completed.stdout + completed.stderr
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Collect CCA sample platform and firmware baseline files."
+    )
+    parser.add_argument("--client", default="/usr/share/rats-tls/samples/cca-client")
+    parser.add_argument("--ip", default="127.0.0.1")
+    parser.add_argument("--port", type=int, default=1234)
+    parser.add_argument("--message", default="baseline probe")
+    parser.add_argument("--log-level", default="info")
+    parser.add_argument("--mutual", action="store_true")
+    parser.add_argument("--workdir", default=".")
+    parser.add_argument("--platform-out", default="platform-baseline.json")
+    parser.add_argument("--firmware-out", default="firmware-baseline.txt")
+    parser.add_argument("--boot-log", default="boot_log.bin")
+    parser.add_argument(
+        "--from-output",
+        help="Parse platform baseline from an existing cca-client output file instead of running the client.",
+    )
+    parser.add_argument(
+        "--skip-client",
+        action="store_true",
+        help="Do not run cca-client; parse --boot-log and optionally --from-output only.",
+    )
+    args = parser.parse_args()
+
+    output_text = ""
+    if args.from_output:
+        output_text = Path(args.from_output).read_text(errors="replace")
+    elif not args.skip_client:
+        output_text = run_client(args)
+
+    if output_text:
+        content, count = parse_platform_baseline(output_text)
+        Path(args.platform_out).write_text(content + "\n")
+        print(f"wrote {args.platform_out} ({count} platform components)")
+    else:
+        print("skipped platform baseline generation")
+
+    if os.path.exists(args.boot_log):
+        lines, count = parse_firmware_baseline(args.boot_log)
+        Path(args.firmware_out).write_text("\n".join(lines) + "\n")
+        print(f"wrote {args.firmware_out} ({count} firmware events)")
+    else:
+        print(f"skipped firmware baseline generation: {args.boot_log} not found")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as error:
+        print(f"error: {error}", file=sys.stderr)
+        sys.exit(1)
