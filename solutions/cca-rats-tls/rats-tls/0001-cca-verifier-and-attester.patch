diff --git a/src/tls_wrappers/openssl/get_nonce.c b/src/tls_wrappers/openssl/get_nonce.c
new file mode 100644
index 0000000..490cd1c
--- /dev/null
+++ b/src/tls_wrappers/openssl/get_nonce.c
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <string.h>
+#include <rats-tls/log.h>
+#include <rats-tls/tls_wrapper.h>
+#include "openssl.h"
+
+tls_wrapper_err_t openssl_tls_get_nonce(tls_wrapper_ctx_t *ctx, bool peer, void *buf,
+					size_t *buf_size)
+{
+	if (!ctx || !buf || !buf_size)
+		return -TLS_WRAPPER_ERR_INVALID;
+
+	openssl_ctx_t *ssl_ctx = ctx->tls_private;
+	if (!ssl_ctx || !ssl_ctx->ssl)
+		return -TLS_WRAPPER_ERR_NONCE;
+
+	size_t len;
+	bool server = (ctx->conf_flags & RATS_TLS_CONF_FLAGS_SERVER) != 0;
+	if ((server && peer) || (!server && !peer))
+		len = SSL_get_client_random(ssl_ctx->ssl, buf, *buf_size);
+	else
+		len = SSL_get_server_random(ssl_ctx->ssl, buf, *buf_size);
+
+	if (!len)
+		return -TLS_WRAPPER_ERR_NONCE;
+	*buf_size = len;
+	return TLS_WRAPPER_ERR_NONE;
+}
