+#define CCA_TSM_OUTBLOB CCA_TSM_REPORT_DIR "/outblob"
+#define CCA_TSM_AUXBLOB CCA_TSM_REPORT_DIR "/auxblob"
+
+#define CCA_EVIDENCE_CAPACITY 8192U
+#define CCA_CHALLENGE_SIZE 32U
+
+#endif
