diff --git a/src/verifiers/cca/verify_evidence.c b/src/verifiers/cca/verify_evidence.c
new file mode 100644
index 0000000..1a73f2f
--- /dev/null
+++ b/src/verifiers/cca/verify_evidence.c
@@ -0,0 +1,504 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <limits.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <openssl/bio.h>
+#include <openssl/ec.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+#include <qcbor/qcbor.h>
+#include <qcbor/qcbor_spiffy_decode.h>
+#include <t_cose/t_cose_sign1_verify.h>
+#include <rats-tls/log.h>
+#include <rats-tls/verifier.h>
+#include "cca_verifier.h"
+#include "trust_anchors.h"
+
+#define CCA_TOKEN_COLLECTION_TAG 399
+#define CCA_PLATFORM_TOKEN_LABEL 44234
+#define CCA_REALM_TOKEN_LABEL 44241
+
+#define CCA_CLAIM_CHALLENGE 10
+#define CCA_CLAIM_PROFILE 265
+#define CCA_REALM_RPV 44235
+#define CCA_REALM_HASH_ALG 44236
+#define CCA_REALM_RAK 44237
+#define CCA_REALM_RIM 44238
+#define CCA_REALM_REM 44239
+#define CCA_REALM_RAK_HASH_ALG 44240
+#define CCA_PLATFORM_IMPLEMENTATION_ID 2396
+#define CCA_PLATFORM_INSTANCE_ID 256
+#define CCA_PLATFORM_CONFIG 2401
+#define CCA_PLATFORM_LIFECYCLE 2395
+#define CCA_PLATFORM_SW_COMPONENTS 2399
+#define CCA_PLATFORM_VERIFICATION_SERVICE 2400
+#define CCA_PLATFORM_HASH_ALG 2402
+#define CCA_SW_COMPONENT_TYPE 1
+#define CCA_SW_COMPONENT_MEASUREMENT 2
+#define CCA_SW_COMPONENT_VERSION 4
+#define CCA_SW_COMPONENT_SIGNER_ID 5
+#define CCA_SW_COMPONENT_HASH_ALG 6
+
+#define CCA_IMPLEMENTATION_ID_SIZE 32
+#define CCA_INSTANCE_ID_SIZE 33
+#define CCA_RPV_SIZE 64
+#define CCA_P521_COORDINATE_SIZE 66
+#define CCA_P521_PUBLIC_KEY_SIZE 133
+
+static void free_buffer(rtls_cca_buffer_t *buffer)
+{
+	free((void *)buffer->data);
+	buffer->data = NULL;
+	buffer->size = 0;
+}
+
+void cca_verifier_reset(cca_verifier_private_t *private)
+{
+	if (!private)
+		return;
+
+	rtls_cca_platform_claims_t *p = &private->public_view.platform;
+	free_buffer(&p->profile);
+	free_buffer(&p->challenge);
+	free_buffer(&p->implementation_id);
+	free_buffer(&p->instance_id);
+	free_buffer(&p->config);
+	free_buffer(&p->verification_service);
+	free_buffer(&p->hash_algorithm);
+	for (size_t i = 0; i < p->software_component_count; ++i) {
+		rtls_cca_sw_component_t *component =
+			(rtls_cca_sw_component_t *)&p->software_components[i];
+		free_buffer(&component->component_type);
+		free_buffer(&component->measurement);
+		free_buffer(&component->version);
+		free_buffer(&component->signer_id);
+		free_buffer(&component->hash_algorithm);
+	}
+	free((void *)p->software_components);
+
+	rtls_cca_realm_claims_t *r = &private->public_view.realm;
+	free_buffer(&r->challenge);
+	free_buffer(&r->profile);
+	free_buffer(&r->personalization_value);
+	free_buffer(&r->initial_measurement);
+	for (size_t i = 0; i < RATS_TLS_CCA_REM_COUNT; ++i)
+		free_buffer(&r->extensible_measurements[i]);
+	free_buffer(&r->hash_algorithm);
+	free_buffer(&r->realm_attestation_key);
+	free_buffer(&r->realm_attestation_key_hash_algorithm);
+
+	memset(&private->public_view, 0, sizeof(private->public_view));
+}
+
+static int copy_buffer(rtls_cca_buffer_t *destination, UsefulBufC source)
+{
+	if (!source.ptr || source.len == 0)
+		return -1;
+	uint8_t *copy = malloc(source.len);
+	if (!copy)
+		return -1;
+	memcpy(copy, source.ptr, source.len);
+	destination->data = copy;
+	destination->size = source.len;
+	return 0;
+}
+
+static bool buffer_equals(const rtls_cca_buffer_t *buffer, const char *text)
+{
+	size_t len = strlen(text);
+	return buffer->size == len && !memcmp(buffer->data, text, len);
+}
+
+static size_t hash_size_for_name(const rtls_cca_buffer_t *algorithm)
+{
+	if (buffer_equals(algorithm, "sha-256"))
+		return 32;
+	if (buffer_equals(algorithm, "sha-384"))
+		return 48;
+	if (buffer_equals(algorithm, "sha-512"))
+		return 64;
+	return 0;
+}
+
+static const EVP_MD *hash_md_for_name(const rtls_cca_buffer_t *algorithm)
+{
+	if (buffer_equals(algorithm, "sha-256"))
+		return EVP_sha256();
+	if (buffer_equals(algorithm, "sha-384"))
+		return EVP_sha384();
+	if (buffer_equals(algorithm, "sha-512"))
+		return EVP_sha512();
+	return NULL;
+}
+
+static int decode_collection(const uint8_t *token, size_t token_len, UsefulBufC *platform,
+			     UsefulBufC *realm)
+{
+	QCBORDecodeContext decode;
+	QCBORItem map;
+	QCBORDecode_Init(&decode, (UsefulBufC) { token, token_len }, QCBOR_DECODE_MODE_NORMAL);
+	QCBORDecode_EnterMap(&decode, &map);
+	if (QCBORDecode_GetError(&decode) != QCBOR_SUCCESS ||
+	    !QCBORDecode_IsTagged(&decode, &map, CCA_TOKEN_COLLECTION_TAG))
+		return -1;
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_PLATFORM_TOKEN_LABEL, platform);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_REALM_TOKEN_LABEL, realm);
+	QCBORDecode_ExitMap(&decode);
+	return QCBORDecode_Finish(&decode) == QCBOR_SUCCESS && platform->len && realm->len ? 0 :
+										     -1;
+}
+
+static int decode_cose_payload(UsefulBufC encoded, EVP_PKEY *key, UsefulBufC *payload)
+{
+	struct t_cose_sign1_verify_ctx verify;
+	struct t_cose_parameters parameters;
+	t_cose_sign1_verify_init(&verify, key ? 0 : T_COSE_OPT_DECODE_ONLY);
+	if (key) {
+		struct t_cose_key cose_key = {
+			.crypto_lib = T_COSE_CRYPTO_LIB_OPENSSL,
+			.k.key_ptr = key,
+		};
+		t_cose_sign1_set_verification_key(&verify, cose_key);
+	}
+	enum t_cose_err_t err = t_cose_sign1_verify(
+		&verify, (struct q_useful_buf_c) { encoded.ptr, encoded.len },
+		(struct q_useful_buf_c *)payload, &parameters);
+	if (err != T_COSE_SUCCESS || parameters.cose_algorithm_id != T_COSE_ALGORITHM_ES512)
+		return -1;
+	return 0;
+}
+
+static X509 *parse_certificate(const uint8_t *data, size_t size)
+{
+	BIO *bio = BIO_new_mem_buf(data, (int)size);
+	if (!bio)
+		return NULL;
+	X509 *certificate = PEM_read_bio_X509(bio, NULL, NULL, NULL);
+	BIO_free(bio);
+	if (certificate)
+		return certificate;
+	const unsigned char *cursor = data;
+	return d2i_X509(NULL, &cursor, (long)size);
+}
+
+static bool certificate_is_p521(X509 *certificate)
+{
+	EVP_PKEY *pkey = X509_get_pubkey(certificate);
+	if (!pkey || EVP_PKEY_base_id(pkey) != EVP_PKEY_EC) {
+		EVP_PKEY_free(pkey);
+		return false;
+	}
+	EC_KEY *ec = EVP_PKEY_get1_EC_KEY(pkey);
+	EVP_PKEY_free(pkey);
+	if (!ec)
+		return false;
+	const EC_GROUP *group = EC_KEY_get0_group(ec);
+	bool result = group && EC_GROUP_get_curve_name(group) == NID_secp521r1;
+	EC_KEY_free(ec);
+	return result;
+}
+
+static int verify_certificate_chain(const uint8_t *device_data, size_t device_size,
+				    X509 **device_out)
+{
+	X509 *device = parse_certificate(device_data, device_size);
+	X509 *product = parse_certificate((const uint8_t *)cca_product_ca_pem,
+					 sizeof(cca_product_ca_pem) - 1);
+	X509 *root = parse_certificate((const uint8_t *)cca_equipment_root_ca_pem,
+				      sizeof(cca_equipment_root_ca_pem) - 1);
+	if (!device || !product || !root || !certificate_is_p521(device) ||
+	    X509_cmp_current_time(X509_get0_notBefore(device)) >= 0 ||
+	    X509_cmp_current_time(X509_get0_notAfter(device)) <= 0 ||
+	    X509_cmp_current_time(X509_get0_notBefore(product)) >= 0 ||
+	    X509_cmp_current_time(X509_get0_notAfter(product)) <= 0 ||
+	    X509_cmp_current_time(X509_get0_notBefore(root)) >= 0 ||
+	    X509_cmp_current_time(X509_get0_notAfter(root)) <= 0)
+		goto err;
+
+	EVP_PKEY *product_key = X509_get_pubkey(product);
+	EVP_PKEY *root_key = X509_get_pubkey(root);
+	if (!product_key || !root_key || X509_verify(device, product_key) != 1 ||
+	    X509_verify(product, root_key) != 1 || X509_verify(root, root_key) != 1) {
+		EVP_PKEY_free(product_key);
+		EVP_PKEY_free(root_key);
+		goto err;
+	}
+	EVP_PKEY_free(product_key);
+	EVP_PKEY_free(root_key);
+	X509_free(product);
+	X509_free(root);
+	*device_out = device;
+	return 0;
+err:
+	X509_free(device);
+	X509_free(product);
+	X509_free(root);
+	return -1;
+}
+
+static int decode_realm_claims(UsefulBufC payload, cca_verifier_private_t *private,
+			       EVP_PKEY **rak_key, uint8_t rak_raw[CCA_P521_PUBLIC_KEY_SIZE])
+{
+	QCBORDecodeContext decode;
+	QCBORItem map;
+	UsefulBufC challenge, profile, rpv, rim, hash_alg, rak, rak_hash_alg;
+	QCBORDecode_Init(&decode, payload, QCBOR_DECODE_MODE_NORMAL);
+	QCBORDecode_EnterMap(&decode, &map);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_CLAIM_CHALLENGE, &challenge);
+	QCBORDecode_GetTextStringInMapN(&decode, CCA_CLAIM_PROFILE, &profile);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_REALM_RPV, &rpv);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_REALM_RIM, &rim);
+	QCBORDecode_GetTextStringInMapN(&decode, CCA_REALM_HASH_ALG, &hash_alg);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_REALM_RAK, &rak);
+	QCBORDecode_GetTextStringInMapN(&decode, CCA_REALM_RAK_HASH_ALG, &rak_hash_alg);
+	QCBORItem rem_item;
+	QCBORDecode_GetItemInMapN(&decode, CCA_REALM_REM, QCBOR_TYPE_ARRAY, &rem_item);
+	if (QCBORDecode_GetError(&decode) != QCBOR_SUCCESS ||
+	    rem_item.val.uCount != RATS_TLS_CCA_REM_COUNT)
+		return -1;
+
+	rtls_cca_realm_claims_t *view = &private->public_view.realm;
+	if (challenge.len != RATS_TLS_CCA_CHALLENGE_SIZE || profile.len == 0 ||
+	    rpv.len != CCA_RPV_SIZE || copy_buffer(&view->challenge, challenge) ||
+	    copy_buffer(&view->profile, profile) ||
+	    copy_buffer(&view->personalization_value, rpv) ||
+	    copy_buffer(&view->initial_measurement, rim) ||
+	    copy_buffer(&view->hash_algorithm, hash_alg) ||
+	    copy_buffer(&view->realm_attestation_key, rak) ||
+	    copy_buffer(&view->realm_attestation_key_hash_algorithm, rak_hash_alg))
+		return -1;
+
+	QCBORDecode_EnterArrayFromMapN(&decode, CCA_REALM_REM);
+	for (size_t i = 0; i < RATS_TLS_CCA_REM_COUNT; ++i) {
+		UsefulBufC rem;
+		QCBORDecode_GetByteString(&decode, &rem);
+		if (copy_buffer(&view->extensible_measurements[i], rem))
+			return -1;
+	}
+	QCBORDecode_ExitArray(&decode);
+	QCBORDecode_ExitMap(&decode);
+	if (QCBORDecode_Finish(&decode) != QCBOR_SUCCESS)
+		return -1;
+
+	size_t measurement_size = hash_size_for_name(&view->hash_algorithm);
+	if (!measurement_size || view->initial_measurement.size != measurement_size)
+		return -1;
+	for (size_t i = 0; i < RATS_TLS_CCA_REM_COUNT; ++i)
+		if (view->extensible_measurements[i].size != measurement_size)
+			return -1;
+
+	QCBORDecodeContext key_decode;
+	QCBORItem key_map;
+	int64_t key_type = 0;
+	int64_t curve = 0;
+	UsefulBufC x, y;
+	QCBORDecode_Init(&key_decode, rak, QCBOR_DECODE_MODE_NORMAL);
+	QCBORDecode_EnterMap(&key_decode, &key_map);
+	QCBORDecode_GetInt64InMapN(&key_decode, 1, &key_type);
+	QCBORDecode_GetInt64InMapN(&key_decode, -1, &curve);
+	QCBORDecode_GetByteStringInMapN(&key_decode, -2, &x);
+	QCBORDecode_GetByteStringInMapN(&key_decode, -3, &y);
+	QCBORDecode_ExitMap(&key_decode);
+	if (QCBORDecode_Finish(&key_decode) != QCBOR_SUCCESS || key_type != 2 || curve != 3 ||
+	    x.len != CCA_P521_COORDINATE_SIZE || y.len != CCA_P521_COORDINATE_SIZE)
+		return -1;
+
+	rak_raw[0] = 4;
+	memcpy(rak_raw + 1, x.ptr, x.len);
+	memcpy(rak_raw + 1 + x.len, y.ptr, y.len);
+	EC_GROUP *group = EC_GROUP_new_by_curve_name(NID_secp521r1);
+	EC_POINT *point = group ? EC_POINT_new(group) : NULL;
+	EC_KEY *ec = group ? EC_KEY_new_by_curve_name(NID_secp521r1) : NULL;
+	if (!group || !point || !ec ||
+	    EC_POINT_oct2point(group, point, rak_raw, CCA_P521_PUBLIC_KEY_SIZE, NULL) != 1 ||
+	    EC_KEY_set_public_key(ec, point) != 1) {
+		EC_KEY_free(ec);
+		EC_POINT_free(point);
+		EC_GROUP_free(group);
+		return -1;
+	}
+	*rak_key = EVP_PKEY_new();
+	if (!*rak_key || EVP_PKEY_assign_EC_KEY(*rak_key, ec) != 1) {
+		EVP_PKEY_free(*rak_key);
+		*rak_key = NULL;
+		EC_KEY_free(ec);
+		EC_POINT_free(point);
+		EC_GROUP_free(group);
+		return -1;
+	}
+	EC_POINT_free(point);
+	EC_GROUP_free(group);
+	return 0;
+}
+
+static int decode_platform_claims(UsefulBufC payload, cca_verifier_private_t *private)
+{
+	QCBORDecodeContext decode;
+	QCBORItem map;
+	UsefulBufC profile, challenge, impl_id, inst_id, config, verification_service, hash_alg;
+	uint64_t lifecycle = 0;
+	QCBORDecode_Init(&decode, payload, QCBOR_DECODE_MODE_NORMAL);
+	QCBORDecode_EnterMap(&decode, &map);
+	QCBORDecode_GetTextStringInMapN(&decode, CCA_CLAIM_PROFILE, &profile);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_CLAIM_CHALLENGE, &challenge);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_PLATFORM_IMPLEMENTATION_ID, &impl_id);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_PLATFORM_INSTANCE_ID, &inst_id);
+	QCBORDecode_GetByteStringInMapN(&decode, CCA_PLATFORM_CONFIG, &config);
+	QCBORDecode_GetUInt64InMapN(&decode, CCA_PLATFORM_LIFECYCLE, &lifecycle);
+	QCBORDecode_GetTextStringInMapN(&decode, CCA_PLATFORM_VERIFICATION_SERVICE,
+					&verification_service);
+	QCBORDecode_GetTextStringInMapN(&decode, CCA_PLATFORM_HASH_ALG, &hash_alg);
+	QCBORItem components_item;
+	QCBORDecode_GetItemInMapN(&decode, CCA_PLATFORM_SW_COMPONENTS, QCBOR_TYPE_ARRAY,
+				  &components_item);
+	if (QCBORDecode_GetError(&decode) != QCBOR_SUCCESS || profile.len == 0 ||
+	    impl_id.len != CCA_IMPLEMENTATION_ID_SIZE || inst_id.len != CCA_INSTANCE_ID_SIZE ||
+	    lifecycle > UINT16_MAX || components_item.val.uCount == 0 ||
+	    components_item.val.uCount == QCBOR_COUNT_INDICATES_INDEFINITE_LENGTH ||
+	    components_item.val.uCount > payload.len ||
+	    components_item.val.uCount > SIZE_MAX / sizeof(rtls_cca_sw_component_t))
+		return -1;
+
+	rtls_cca_platform_claims_t *view = &private->public_view.platform;
+	if (copy_buffer(&view->profile, profile) || copy_buffer(&view->challenge, challenge) ||
+	    copy_buffer(&view->implementation_id, impl_id) ||
+	    copy_buffer(&view->instance_id, inst_id) || copy_buffer(&view->config, config) ||
+	    copy_buffer(&view->verification_service, verification_service) ||
+	    copy_buffer(&view->hash_algorithm, hash_alg))
+		return -1;
+	view->lifecycle = (uint16_t)lifecycle;
+	view->software_component_count = components_item.val.uCount;
+	rtls_cca_sw_component_t *components =
+		calloc(view->software_component_count, sizeof(*components));
+	if (!components)
+		return -1;
+	view->software_components = components;
+
+	QCBORDecode_EnterArrayFromMapN(&decode, CCA_PLATFORM_SW_COMPONENTS);
+	for (size_t i = 0; i < view->software_component_count; ++i) {
+		QCBORItem component_map;
+		UsefulBufC type, measurement, version, signer_id, component_hash_alg;
+		QCBORDecode_EnterMap(&decode, &component_map);
+		QCBORDecode_GetTextStringInMapN(&decode, CCA_SW_COMPONENT_TYPE, &type);
+		QCBORDecode_GetByteStringInMapN(&decode, CCA_SW_COMPONENT_MEASUREMENT,
+						&measurement);
+		QCBORDecode_GetTextStringInMapN(&decode, CCA_SW_COMPONENT_VERSION, &version);
+		QCBORDecode_GetByteStringInMapN(&decode, CCA_SW_COMPONENT_SIGNER_ID, &signer_id);
+		QCBORDecode_GetTextStringInMapN(&decode, CCA_SW_COMPONENT_HASH_ALG,
+						&component_hash_alg);
+		if (QCBORDecode_GetError(&decode) != QCBOR_SUCCESS || type.len == 0 ||
+		    version.len == 0 || copy_buffer(&components[i].component_type, type) ||
+		    copy_buffer(&components[i].measurement, measurement) ||
+		    copy_buffer(&components[i].version, version) ||
+		    copy_buffer(&components[i].signer_id, signer_id) ||
+		    copy_buffer(&components[i].hash_algorithm, component_hash_alg))
+			return -1;
+		size_t digest_size = hash_size_for_name(&components[i].hash_algorithm);
+		if (!digest_size || components[i].measurement.size != digest_size ||
+		    components[i].signer_id.size != digest_size)
+			return -1;
+		QCBORDecode_ExitMap(&decode);
+	}
+	QCBORDecode_ExitArray(&decode);
+	QCBORDecode_ExitMap(&decode);
+	return QCBORDecode_Finish(&decode) == QCBOR_SUCCESS ? 0 : -1;
+}
+
+static int verify_rak_binding(const cca_verifier_private_t *private,
+			      const uint8_t rak_raw[CCA_P521_PUBLIC_KEY_SIZE])
+{
+	const rtls_cca_buffer_t *algorithm =
+		&private->public_view.realm.realm_attestation_key_hash_algorithm;
+	const EVP_MD *md = hash_md_for_name(algorithm);
+	if (!md)
+		return -1;
+	uint8_t digest[EVP_MAX_MD_SIZE];
+	unsigned int digest_size = 0;
+	if (EVP_Digest(rak_raw, CCA_P521_PUBLIC_KEY_SIZE, digest, &digest_size, md, NULL) != 1)
+		return -1;
+	const rtls_cca_buffer_t *challenge = &private->public_view.platform.challenge;
+	return challenge->size == digest_size && !memcmp(challenge->data, digest, digest_size) ? 0 :
+												 -1;
+}
+
+static int unpack_evidence(const cca_attestation_evidence_t *evidence, const uint8_t **token,
+			   size_t *token_len, const uint8_t **cert, size_t *cert_len)
+{
+	if (evidence->report_len < sizeof(uint64_t) * 2)
+		return -1;
+	const uint8_t *cursor = evidence->report;
+	uint64_t token_size = 0;
+	memcpy(&token_size, cursor, sizeof(token_size));
+	cursor += sizeof(token_size);
+	if (token_size == 0 || token_size > evidence->report_len - sizeof(uint64_t) * 2)
+		return -1;
+	cursor += token_size;
+	uint64_t cert_size = 0;
+	memcpy(&cert_size, cursor, sizeof(cert_size));
+	cursor += sizeof(cert_size);
+	uint64_t remaining = evidence->report_len - sizeof(uint64_t) * 2 - token_size;
+	if (cert_size == 0 || cert_size != remaining)
+		return -1;
+	*token = evidence->report + sizeof(uint64_t);
+	*token_len = (size_t)token_size;
+	*cert = cursor;
+	*cert_len = (size_t)cert_size;
+	return 0;
+}
+
+enclave_verifier_err_t cca_verify_evidence(
+	enclave_verifier_ctx_t *ctx, attestation_evidence_t *evidence, uint8_t *hash,
+	uint32_t hash_len, __attribute__((unused)) attestation_endorsement_t *endorsements)
+{
+	if (!ctx || !ctx->verifier_private || !evidence || !hash ||
+	    hash_len != RATS_TLS_CCA_CHALLENGE_SIZE)
+		return -ENCLAVE_VERIFIER_ERR_INVALID;
+
+	cca_verifier_private_t *private = ctx->verifier_private;
+	cca_verifier_reset(private);
+	const uint8_t *token = NULL;
+	const uint8_t *cert_data = NULL;
+	size_t token_len = 0;
+	size_t cert_len = 0;
+	X509 *device = NULL;
+	EVP_PKEY *device_key = NULL;
+	EVP_PKEY *rak_key = NULL;
+	int result = -1;
+
+	if (unpack_evidence(&evidence->cca, &token, &token_len, &cert_data, &cert_len) ||
+	    verify_certificate_chain(cert_data, cert_len, &device))
+		goto out;
+
+	UsefulBufC platform_token, realm_token, platform_payload, realm_payload;
+	if (decode_collection(token, token_len, &platform_token, &realm_token) ||
+	    decode_cose_payload(platform_token, NULL, &platform_payload) ||
+	    decode_cose_payload(realm_token, NULL, &realm_payload) ||
+	    decode_platform_claims(platform_payload, private))
+		goto out;
+
+	uint8_t rak_raw[CCA_P521_PUBLIC_KEY_SIZE];
+	if (decode_realm_claims(realm_payload, private, &rak_key, rak_raw) ||
+	    private->public_view.realm.challenge.size != hash_len ||
+	    memcmp(private->public_view.realm.challenge.data, hash, hash_len) ||
+	    verify_rak_binding(private, rak_raw))
+		goto out;
+
+	device_key = X509_get_pubkey(device);
+	if (!device_key || decode_cose_payload(platform_token, device_key, &platform_payload) ||
+	    decode_cose_payload(realm_token, rak_key, &realm_payload))
+		goto out;
+
+	result = 0;
+out:
+	EVP_PKEY_free(device_key);
+	EVP_PKEY_free(rak_key);
+	X509_free(device);
+	if (result) {
+		cca_verifier_reset(private);
+		RTLS_ERR("CCA evidence verification failed\n");
+		return -ENCLAVE_VERIFIER_ERR_INVALID;
+	}
+	return ENCLAVE_VERIFIER_ERR_NONE;
+}
