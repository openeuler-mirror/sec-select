diff --git a/src/attesters/cca/collect_evidence.c b/src/attesters/cca/collect_evidence.c
new file mode 100644
index 0000000..dfce041
--- /dev/null
+++ b/src/attesters/cca/collect_evidence.c
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <rats-tls/attester.h>
+#include <rats-tls/log.h>
+#include "cca_attester.h"
+
+static pthread_mutex_t cca_report_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static int write_all(int fd, const uint8_t *data, size_t size)
+{
+	while (size) {
+		ssize_t written = write(fd, data, size);
+		if (written < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		data += written;
+		size -= (size_t)written;
+	}
+	return 0;
+}
+
+static int read_bounded_file(const char *path, uint8_t *buffer, size_t capacity, size_t *size)
+{
+	int fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return -1;
+
+	size_t total = 0;
+	while (total < capacity) {
+		ssize_t got = read(fd, buffer + total, capacity - total);
+		if (got < 0) {
+			if (errno == EINTR)
+				continue;
+			close(fd);
+			return -1;
+		}
+		if (got == 0)
+			break;
+		total += (size_t)got;
+	}
+
+	uint8_t extra;
+	if (total == capacity && read(fd, &extra, 1) > 0) {
+		close(fd);
+		return -1;
+	}
+	close(fd);
+
+	if (total == 0)
+		return -1;
+	*size = total;
+	return 0;
+}
+
+enclave_attester_err_t cca_collect_evidence(
+	__attribute__((unused)) enclave_attester_ctx_t *ctx, attestation_evidence_t *evidence,
+	__attribute__((unused)) rats_tls_cert_algo_t algo, uint8_t *hash, uint32_t hash_len)
+{
+	if (!evidence || !hash || hash_len != CCA_CHALLENGE_SIZE)
+		return -ENCLAVE_ATTESTER_ERR_INVALID;
+
+	int ret = pthread_mutex_lock(&cca_report_lock);
+	if (ret)
+		return -ENCLAVE_ATTESTER_ERR_UNKNOWN;
+
+	enclave_attester_err_t result = -ENCLAVE_ATTESTER_ERR_INVALID;
+	int fd = open(CCA_TSM_INBLOB, O_WRONLY | O_TRUNC);
+	if (fd < 0) {
+		RTLS_ERR("failed to open %s: %s\n", CCA_TSM_INBLOB, strerror(errno));
+		goto out;
+	}
+	if (write_all(fd, hash, hash_len)) {
+		RTLS_ERR("failed to write CCA challenge: %s\n", strerror(errno));
+		close(fd);
+		goto out;
+	}
+	if (fsync(fd) && errno != EINVAL) {
+		RTLS_ERR("failed to flush CCA challenge: %s\n", strerror(errno));
+		close(fd);
+		goto out;
+	}
+	close(fd);
+
+	uint8_t token[CCA_EVIDENCE_CAPACITY];
+	uint8_t cert[CCA_EVIDENCE_CAPACITY];
+	size_t token_len = 0;
+	size_t cert_len = 0;
+	if (read_bounded_file(CCA_TSM_OUTBLOB, token, sizeof(token), &token_len) ||
+	    read_bounded_file(CCA_TSM_AUXBLOB, cert, sizeof(cert), &cert_len)) {
+		RTLS_ERR("failed to read CCA token or device certificate\n");
+		goto out;
+	}
+
+	const size_t header_size = sizeof(uint64_t) * 2;
+	if (token_len > UINT64_MAX || cert_len > UINT64_MAX ||
+	    header_size + token_len + cert_len > sizeof(evidence->cca.report)) {
+		RTLS_ERR("CCA evidence exceeds %zu-byte capacity\n", sizeof(evidence->cca.report));
+		goto out;
+	}
+
+	uint64_t token_len_u64 = (uint64_t)token_len;
+	uint64_t cert_len_u64 = (uint64_t)cert_len;
+	uint8_t *cursor = evidence->cca.report;
+	memcpy(cursor, &token_len_u64, sizeof(token_len_u64));
+	cursor += sizeof(token_len_u64);
+	memcpy(cursor, token, token_len);
+	cursor += token_len;
+	memcpy(cursor, &cert_len_u64, sizeof(cert_len_u64));
+	cursor += sizeof(cert_len_u64);
+	memcpy(cursor, cert, cert_len);
+
+	evidence->cca.report_len = (uint32_t)(header_size + token_len + cert_len);
+	snprintf(evidence->type, sizeof(evidence->type), "cca");
+	result = ENCLAVE_ATTESTER_ERR_NONE;
+out:
+	pthread_mutex_unlock(&cca_report_lock);
+	return result;
+}
