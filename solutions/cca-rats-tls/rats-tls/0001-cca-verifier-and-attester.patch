new file mode 100644
index 0000000..4bcc6f1
--- /dev/null
+++ b/src/attesters/cca/main.c
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <rats-tls/attester.h>
+#include <rats-tls/log.h>
+
+extern enclave_attester_err_t enclave_attester_register(enclave_attester_opts_t *);
+extern enclave_attester_err_t cca_attester_pre_init(void);
+extern enclave_attester_err_t cca_attester_init(enclave_attester_ctx_t *, rats_tls_cert_algo_t);
+extern enclave_attester_err_t cca_collect_evidence(enclave_attester_ctx_t *,
+						   attestation_evidence_t *,
+						   rats_tls_cert_algo_t, uint8_t *, uint32_t);
+extern enclave_attester_err_t cca_attester_cleanup(enclave_attester_ctx_t *);
+
+static enclave_attester_opts_t cca_attester_opts = {
+	.api_version = ENCLAVE_ATTESTER_API_VERSION_DEFAULT,
+	.flags = ENCLAVE_ATTESTER_OPTS_FLAGS_CCA_GUEST,
+	.name = "cca",
+	.priority = 45,
+	.pre_init = cca_attester_pre_init,
+	.init = cca_attester_init,
+	.collect_evidence = cca_collect_evidence,
+	.cleanup = cca_attester_cleanup,
+};
+
+void __attribute__((constructor)) libattester_cca_init(void)
+{
+	enclave_attester_err_t err = enclave_attester_register(&cca_attester_opts);
+	if (err != ENCLAVE_ATTESTER_ERR_NONE)
+		RTLS_DEBUG("failed to register attester 'cca' %#x\n", err);
+}
diff --git a/src/attesters/cca/pre_init.c b/src/attesters/cca/pre_init.c
new file mode 100644
index 0000000..da8f2ba
--- /dev/null
+++ b/src/attesters/cca/pre_init.c
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <unistd.h>
+#include <rats-tls/attester.h>
+#include <rats-tls/log.h>
+#include "cca_attester.h"
+
+enclave_attester_err_t cca_attester_pre_init(void)
+{
+#ifndef __aarch64__
+	RTLS_DEBUG("CCA attestation is only available on AArch64\n");
+	return -ENCLAVE_ATTESTER_ERR_CPU_UNSUPPORTED;
+#else
+	if (access(CCA_TSM_INBLOB, W_OK) || access(CCA_TSM_OUTBLOB, R_OK) ||
+	    access(CCA_TSM_AUXBLOB, R_OK)) {
+		RTLS_DEBUG("CCA TSM report interface is unavailable\n");
+		return -ENCLAVE_ATTESTER_ERR_NO_TOOL;
+	}
+	return ENCLAVE_ATTESTER_ERR_NONE;
+#endif
+}
