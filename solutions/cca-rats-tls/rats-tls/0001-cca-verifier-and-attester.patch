+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stdlib.h>
+#include <rats-tls/verifier.h>
+#include "cca_verifier.h"
+
+enclave_verifier_err_t cca_verifier_cleanup(enclave_verifier_ctx_t *ctx)
+{
+	if (ctx && ctx->verifier_private) {
+		cca_verifier_reset(ctx->verifier_private);
